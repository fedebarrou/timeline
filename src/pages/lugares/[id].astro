---
import BaseLayout from '../../layouts/BaseLayout.astro';
import TranslucentBackdrop from '../../components/TranslucentBackdrop.astro';
import { getCollection } from 'astro:content';

export async function getStaticPaths() {
  const locs = await getCollection('locations');
  return locs.map((l) => ({ params: { id: l.data.id }, props: { loc: l } }));
}

const { loc } = Astro.props;
const data = loc.data;

// Look up events that happen at this location
const events = await getCollection('events');
const eventsHere = events.filter((e) => data.events?.includes(e.data.id));
---
<BaseLayout title={`${data.ancientName} · Lugar`}>
  <TranslucentBackdrop src={data.portrait} alt={data.ancientName} />

  <article class="relative z-10 px-6 py-16 max-w-4xl mx-auto">
    <div class="back-link-bar">
      <a
        href="/lugares"
        class="back-link inline-flex items-center gap-2 text-sm tracking-[0.25em] uppercase opacity-70 hover:opacity-100 hover:text-accent transition-opacity"
        data-back-link
        data-default-href="/lugares"
        data-default-label="Volver a lugares"
      >
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <polyline points="15 18 9 12 15 6"></polyline>
        </svg>
        <span data-back-label>Volver a lugares</span>
      </a>
    </div>
    <script is:inline>
      (function () {
        var link = document.querySelector('[data-back-link]');
        if (!link) return;
        var labelEl = link.querySelector('[data-back-label]');
        var bar = link.closest('.back-link-bar');

        function applyEventReturn(era, eventId) {
          link.setAttribute('href', '/era/' + era + '#event-' + eventId);
          if (labelEl) labelEl.textContent = 'Volver al evento';
          if (bar) bar.setAttribute('data-has-return', 'event');
        }
        function applyEraReturn(era) {
          link.setAttribute('href', '/era/' + era);
          if (labelEl) labelEl.textContent = 'Volver a la era';
          if (bar) bar.setAttribute('data-has-return', 'era');
        }

        // Priority 1: explicit ?from=eraId/event-eventId query param.
        try {
          var params = new URLSearchParams(window.location.search);
          var from = params.get('from');
          if (from) {
            var parts = from.split('/');
            if (parts.length === 2 && parts[0] && parts[1].indexOf('event-') === 0) {
              applyEventReturn(parts[0], parts[1].slice('event-'.length));
              return;
            }
            if (parts.length === 1 && parts[0]) {
              applyEraReturn(parts[0]);
              return;
            }
          }
        } catch (_) { /* noop */ }

        // Priority 2: document.referrer — if user came from /era/{id} (hash
        // is stripped by the browser, so we cannot recover the event anchor)
        // we still offer a generic "Volver a la era".
        try {
          if (document.referrer) {
            var refUrl = new URL(document.referrer);
            if (refUrl.origin === window.location.origin) {
              var m = refUrl.pathname.match(/^\/era\/([^\/]+)\/?$/);
              if (m) {
                applyEraReturn(m[1]);
                return;
              }
            }
          }
        } catch (_) { /* noop */ }
      })();
    </script>
    <header class="mb-10">
      <p class="text-sm tracking-[0.4em] uppercase opacity-60 mb-2">Lugar · {data.region}</p>
      <h1 class="font-display text-5xl">{data.ancientName}</h1>
      {data.modernName && (
        <p class="text-base md:text-lg opacity-70 mt-2 italic font-display">{data.modernName}</p>
      )}
      {data.disputed && (
        <div class="disputed-badge mt-5">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M12 9v4"></path>
            <path d="M12 17h.01"></path>
            <path d="M10.29 3.86 1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"></path>
          </svg>
          <span>Localización disputada</span>
        </div>
      )}
    </header>

    <section class="mb-10">
      <p class="text-lg leading-relaxed opacity-90">{data.description}</p>
    </section>

    {data.proposedLocations && data.proposedLocations.length > 0 && (
      <section class="mb-10">
        <div class="proposals-header">
          <h2 class="font-display text-2xl">Localizaciones propuestas</h2>
          <p class="proposals-sub">{data.proposedLocations.length} {data.proposedLocations.length === 1 ? 'hipótesis' : 'hipótesis'} según fuentes y tradiciones distintas</p>
        </div>
        <ol class="proposals-list">
          {data.proposedLocations.map((p: any, idx: number) => (
            <li class="proposal-item">
              <span class="proposal-number">{idx + 1}</span>
              <div class="proposal-body">
                <h3 class="font-display text-lg proposal-name">{p.name}</h3>
                <p class="text-base opacity-80 mt-1 leading-relaxed">{p.support}</p>
                <p class="text-xs opacity-50 mt-2 tracking-wider uppercase">Coords · {p.coords.join(', ')}</p>
              </div>
            </li>
          ))}
        </ol>
      </section>
    )}

    {eventsHere.length > 0 && (
      <section class="mb-10">
        <h2 class="font-display text-2xl mb-4">Eventos en este lugar</h2>
        <ul class="space-y-2">
          {eventsHere.map((e) => (
            <li>
              <a href={`/era/${e.data.era}#event-${e.data.id}`} class="inline-flex items-center gap-2 text-base hover:text-accent">
                → <span class="font-display">{e.data.title}</span>
                <span class="opacity-50 text-sm">· año {e.data.biblicalYear}</span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    )}
  </article>
</BaseLayout>

<style>
  .disputed-badge {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 8px 16px;
    border: 1.5px solid var(--era-accent, #f59e0b);
    border-radius: 999px;
    background: color-mix(in srgb, var(--era-accent, #f59e0b) 14%, transparent);
    color: var(--era-accent, #f59e0b);
    font-family: var(--era-display, 'Cinzel', serif);
    font-size: 13px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    font-weight: 600;
    box-shadow: 0 2px 14px color-mix(in srgb, var(--era-accent, #f59e0b) 22%, transparent);
  }
  .disputed-badge svg { flex-shrink: 0; }

  .proposals-header { margin-bottom: 18px; }
  .proposals-sub {
    font-size: 12px;
    opacity: 0.6;
    margin-top: 4px;
    letter-spacing: 0.04em;
  }

  .proposals-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 14px;
    counter-reset: proposal;
  }

  .proposal-item {
    position: relative;
    display: flex;
    gap: 16px;
    padding: 18px 20px;
    border: 1px solid var(--era-border);
    border-left: 3px solid var(--era-accent, #f59e0b);
    border-radius: 10px;
    background: color-mix(in srgb, var(--era-surface, #1a1a1a) 70%, transparent);
    transition: border-color 200ms ease, transform 200ms ease;
  }
  .proposal-item:hover {
    border-color: var(--era-accent, #f59e0b);
    transform: translateX(2px);
  }

  .proposal-number {
    flex-shrink: 0;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    background: color-mix(in srgb, var(--era-accent, #f59e0b) 18%, transparent);
    color: var(--era-accent, #f59e0b);
    font-family: var(--era-display, 'Cinzel', serif);
    font-size: 14px;
    font-weight: 700;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid var(--era-accent, #f59e0b);
  }

  .proposal-body { flex: 1; min-width: 0; }
  .proposal-name { color: var(--era-primary); }

  /* Default (desktop): inline back-link, generous breathing room below. */
  .back-link-bar {
    margin-bottom: 2rem;
  }

  @media (max-width: 767px) {
    /* On mobile, the back-link becomes a sticky bar so it remains
       accessible while the user scrolls long descriptions/proposals. Extra
       prominence (accent text) when a back-to-event or back-to-era return
       target has been resolved by the inline script. */
    .back-link-bar {
      position: sticky;
      top: 0;
      z-index: 30;
      margin: -1rem -1.5rem 1.25rem;
      padding: 0.65rem 1.5rem;
      background: color-mix(in srgb, var(--era-bg, #0b0b0e) 92%, transparent);
      backdrop-filter: blur(8px);
      -webkit-backdrop-filter: blur(8px);
      border-bottom: 1px solid color-mix(in srgb, var(--era-border, #333) 60%, transparent);
    }
    .back-link-bar .back-link {
      opacity: 1;
      min-height: 44px;
    }
    .back-link-bar[data-has-return] .back-link {
      color: var(--era-accent, currentColor);
    }
  }
</style>
