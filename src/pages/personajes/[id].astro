---
import BaseLayout from '../../layouts/BaseLayout.astro';
import CharacterTimeline from '../../components/CharacterTimeline.astro';
import PortraitPlaceholder from '../../components/PortraitPlaceholder.astro';
import TranslucentBackdrop from '../../components/TranslucentBackdrop.astro';
import CharacterNavSidebar from '../../components/CharacterNavSidebar.astro';
import { orderCharacters, GROUP_TO_ERA } from '../../lib/characterOrder';
import { getCollection, getEntry, render } from 'astro:content';

export async function getStaticPaths() {
  const chars = await getCollection('characters');
  const eras = await getCollection('eras');
  const eraNameById = new Map(eras.map((e) => [e.data.id, e.data.name] as const));

  // For each character, precompute its era + the ordered list of fellow
  // characters in the SAME era. The sidebar then shows just that era's
  // line-up (Adán→Noé while reading anyone primordial, Abraham→Ismael
  // while reading anyone patriarcal, etc.), with the current one
  // highlighted. Doing the filter here keeps the sidebar a dumb renderer.
  return chars.map((c) => {
    const eraId = c.data.group ? GROUP_TO_ERA[c.data.group] : undefined;
    const eraName = eraId ? eraNameById.get(eraId) ?? 'Era' : 'Era';
    const sameEra = eraId
      ? chars.filter((ch) => ch.data.group && GROUP_TO_ERA[ch.data.group] === eraId)
      : [c];
    const ordered = orderCharacters(sameEra);
    return {
      params: { id: c.data.id },
      props: { char: c, ordered, eraName },
    };
  });
}

const { char, ordered, eraName } = Astro.props;
const data = char.data;
const { Content } = await render(char);

type CharEvent = {
  id: string;
  year: number;
  gregorianYear: number;
  label: string;
  subtitle?: string;
  role?: string;
  lore?: string;
};

const eventEntries = await Promise.all(
  data.events.map(async (id) => {
    const e = await getEntry('events', id);
    if (!e) {
      console.warn(`[personajes/${data.id}] evento referenciado no encontrado: "${id}"`);
      return null;
    }
    const participation = e.data.characters?.find((c) => c.id === data.id);
    return {
      id: e.data.id,
      year: e.data.biblicalYear,
      gregorianYear: e.data.gregorianYear,
      label: e.data.title,
      subtitle: e.data.subtitle,
      role: participation?.role,
      lore: participation?.lore,
    } as CharEvent;
  })
);
const events: CharEvent[] = (eventEntries.filter(Boolean) as CharEvent[]).sort(
  (a, b) => a.year - b.year
);

const mentionsCount =
  data.mentions.tora.length + data.mentions.biblia.length + data.mentions.coran.length;

function formatRole(role?: string): string {
  if (!role) return '';
  return role
    .split('-')
    .map((part) => part.charAt(0).toUpperCase() + part.slice(1))
    .join(' ');
}

function formatGregorian(g: number): string {
  if (g === 0) return '';
  return g < 0 ? `${Math.abs(g)} a.C.` : `${g} d.C.`;
}

const hasLifeRange = data.birthYear !== undefined || data.deathYear !== undefined;
// Años vividos — every character page must surface this, even when unknown.
// Priority: explicit `ageAtDeath` from the schema → computed from birth+death
// dates → fallback to "Desconocido". Some patriarchs have an `ageAtDeath`
// without dated bounds (e.g. tradition records the age but not the year),
// hence the explicit field wins over the difference.
const yearsLivedLabel: string =
  data.ageAtDeath !== undefined
    ? `${data.ageAtDeath} años`
    : data.birthYear !== undefined && data.deathYear !== undefined
      ? `${data.deathYear - data.birthYear} años`
      : 'Desconocido';
---
<BaseLayout title={data.name}>
  <TranslucentBackdrop src={data.portrait} alt={data.name} />
  {/* Sidebar is `position: fixed` (and hidden below 1280px), so it
      doesn't participate in the document flow — the article keeps its
      original centred max-w-4xl rhythm and the sidebar floats in the
      empty left margin only when there's room for it. */}
  <CharacterNavSidebar currentId={data.id} ordered={ordered} eraName={eraName} />
  <div class="relative z-10">
  <article class="px-6 py-16 max-w-4xl mx-auto">
    <a href="/personajes" class="back-link inline-flex items-center gap-2 text-sm tracking-[0.25em] uppercase opacity-70 hover:opacity-100 hover:text-accent transition-opacity mb-8">
      <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <polyline points="15 18 9 12 15 6"></polyline>
      </svg>
      Volver a personajes
    </a>
    <header class="mb-10 flex items-start gap-8">
      <PortraitPlaceholder name={data.name} src={data.portrait} avatar={data.avatar ?? undefined} size="lg" />
      <div>
        <h1 class="font-display text-5xl">{data.name}</h1>
        {(data.alternateNames.hebrew || data.alternateNames.arabic) && (
          <p class="text-lg opacity-70 mt-2">
            {data.alternateNames.hebrew} {data.alternateNames.hebrew && data.alternateNames.arabic && '·'} {data.alternateNames.arabic}
          </p>
        )}
        {data.alternateNames.meaning && (
          <p class="text-xl md:text-2xl italic opacity-75 mt-3 font-display">"{data.alternateNames.meaning}"</p>
        )}
        <p class="text-base opacity-70 mt-4">
          {hasLifeRange && (
            <>
              {data.birthYear !== undefined && data.deathYear !== undefined && `Año ${data.birthYear} — ${data.deathYear}`}
              {data.birthYear !== undefined && data.deathYear === undefined && `Nacido año ${data.birthYear}`}
              {data.birthYear === undefined && data.deathYear !== undefined && `Fallecido año ${data.deathYear}`}
              {' · '}
            </>
          )}
          Años vividos: <span class="font-medium">{yearsLivedLabel}</span>
        </p>
      </div>
    </header>

    {events.length > 0 && (
      <section class="mb-12">
        <h2 class="font-display text-2xl mb-4">Línea de tiempo <span class="text-base opacity-60">({events.length} {events.length === 1 ? 'evento' : 'eventos'})</span></h2>
        <CharacterTimeline birthYear={data.birthYear} deathYear={data.deathYear} events={events} />
        <ol class="mt-10 space-y-5 border-l border-border/60 pl-6">
          {events.map((e) => (
            <li class="relative">
              <span class="absolute -left-[1.7rem] top-1.5 w-2.5 h-2.5 rounded-full bg-primary ring-4 ring-bg" aria-hidden="true"></span>
              <div class="flex flex-wrap items-baseline gap-x-3 gap-y-1">
                <span class="text-sm tracking-[0.2em] uppercase opacity-60 tabular-nums">
                  Año {e.year}{formatGregorian(e.gregorianYear) && ` · ${formatGregorian(e.gregorianYear)}`}
                </span>
                <a href={`/eventos/${e.id}`} class="font-display text-lg hover:text-accent transition-colors">{e.label}</a>
                {e.role && (
                  <span class="text-[11px] tracking-[0.18em] uppercase px-2 py-0.5 rounded-full bg-primary/15 text-primary">
                    {formatRole(e.role)}
                  </span>
                )}
              </div>
              {e.subtitle && <p class="text-base opacity-70 italic mt-1">{e.subtitle}</p>}
              {e.lore && <p class="text-base opacity-85 mt-2 leading-relaxed">{e.lore}</p>}
            </li>
          ))}
        </ol>
      </section>
    )}

    {data.significance && (
      <section class="prose prose-invert max-w-none mb-10">
        <Content />
      </section>
    )}

    <section class="mb-10">
      <h2 class="font-display text-2xl mb-4">Menciones en las escrituras <span class="text-base opacity-60">({mentionsCount} menciones)</span></h2>

      {data.mentions.tora.length > 0 && (
        <div class="mb-6">
          <h3 class="text-sm tracking-[0.3em] uppercase opacity-70 mb-3">📜 Torá ({data.mentions.tora.length})</h3>
          <ul class="space-y-3">
            {data.mentions.tora.map((m) => (
              <li class="border-l-2 border-primary/40 pl-4">
                <p class="font-semibold">{m.book} {m.reference}</p>
                <p class="text-base opacity-80">{m.summary}</p>
                {m.fullText && <details class="text-sm opacity-70 mt-1"><summary class="cursor-pointer">+ cita</summary><blockquote class="italic mt-2">{m.fullText}</blockquote></details>}
              </li>
            ))}
          </ul>
        </div>
      )}

      {data.mentions.biblia.length > 0 && (
        <div class="mb-6">
          <h3 class="text-sm tracking-[0.3em] uppercase opacity-70 mb-3">✝ Biblia ({data.mentions.biblia.length})</h3>
          <ul class="space-y-3">
            {data.mentions.biblia.map((m) => (
              <li class="border-l-2 border-primary/40 pl-4">
                <p class="font-semibold">{m.book} {m.reference}</p>
                <p class="text-base opacity-80">{m.summary}</p>
                {m.fullText && <details class="text-sm opacity-70 mt-1"><summary class="cursor-pointer">+ cita</summary><blockquote class="italic mt-2">{m.fullText}</blockquote></details>}
              </li>
            ))}
          </ul>
        </div>
      )}

      {data.mentions.coran.length > 0 && (
        <div class="mb-6">
          <h3 class="text-sm tracking-[0.3em] uppercase opacity-70 mb-3">☪ Corán ({data.mentions.coran.length})</h3>
          <ul class="space-y-3">
            {data.mentions.coran.map((m) => (
              <li class="border-l-2 border-primary/40 pl-4">
                <p class="font-semibold">Sura {m.sura} ({m.number}) v.{m.verses}</p>
                <p class="text-base opacity-80">{m.summary}</p>
                {m.fullText && <details class="text-sm opacity-70 mt-1"><summary class="cursor-pointer">+ cita</summary><blockquote class="italic mt-2">{m.fullText}</blockquote></details>}
              </li>
            ))}
          </ul>
        </div>
      )}
    </section>

    {data.extraBiblical.length > 0 && (
      <section class="mb-10">
        <h2 class="font-display text-2xl mb-4">Tradiciones complementarias</h2>
        <ul class="space-y-2 text-base">
          {data.extraBiblical.map((e) => (
            <li>🟡 <strong>{e.source}</strong> — {e.summary}</li>
          ))}
        </ul>
      </section>
    )}
  </article>
  </div>
</BaseLayout>
