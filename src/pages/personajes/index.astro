---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortraitPlaceholder from '../../components/PortraitPlaceholder.astro';
import { getCollection } from 'astro:content';

const allChars = await getCollection('characters');
const erasCollection = await getCollection('eras');
const erasById = new Map(erasCollection.map((e) => [e.data.id, e.data]));

const GROUP_TO_ERA: Record<string, string> = {
  // Era Primordial
  'patriarcas': 'primordial',
  'linaje-set': 'primordial',
  'descendientes-cain': 'primordial',
  'vigilantes': 'primordial',
  // Era Patriarcal
  'patriarcal': 'patriarcal',
  'patriarcas-padres-fundadores': 'patriarcal',
  'patriarcas-madres-fundadoras': 'patriarcal',
  'patriarcas-hijos-tribus': 'patriarcal',
  'patriarcas-vinculados': 'patriarcal',
  // Era Éxodo
  'exodo': 'exodo',
  'exodo-liberadores': 'exodo',
  'exodo-faraones-y-egipcios': 'exodo',
  'exodo-generacion-desierto': 'exodo',
  'exodo-conquista-canaan': 'exodo',
  // Era Reinos y Exilio
  'reinos-y-exilio': 'reinos-y-exilio',
  'reinos-jueces': 'reinos-y-exilio',
  'reinos-reyes': 'reinos-y-exilio',
  'reinos-profetas': 'reinos-y-exilio',
  'reinos-exilio-y-retorno': 'reinos-y-exilio',
  // Era Evangelio
  'evangelio-familia': 'evangelio',
  'evangelio-magos': 'evangelio',
  'evangelio-apostoles': 'evangelio',
  'evangelio-primeros-cristianos': 'evangelio',
  // Era Revelación
  'revelacion': 'revelacion',
  'revelacion-familia-mahoma': 'revelacion',
  'revelacion-companeros': 'revelacion',
  'revelacion-opresores-meca': 'revelacion',
  'revelacion-ansar-medina': 'revelacion',
  'revelacion-otros': 'revelacion',
};

const GROUPS = [
  // ── Era Primordial ──
  { id: 'patriarcas',         label: 'Patriarcas pre-diluvio',                description: 'Era Primordial · La línea de Adán hasta Noé y sus hijos, según las genealogías canónicas.' },
  { id: 'linaje-set',         label: 'Línea de Set',                          description: 'Era Primordial · Genealogía completa entre Set y Noé (Génesis 5).' },
  { id: 'descendientes-cain', label: 'Descendientes de Caín',                 description: 'Era Primordial · La rama paralela: los inventores de la civilización temprana.' },
  { id: 'vigilantes',         label: 'Vigilantes y figuras apócrifas',        description: 'Era Primordial · Ángeles caídos, Nephilim y tradiciones extra-bíblicas (Libro de Enoc, Cábala).' },
  // ── Era Patriarcal ──
  { id: 'patriarcas-padres-fundadores', label: 'Padres fundadores',           description: 'Era Patriarcal · Abraham, Isaac, Jacob, José, Ismael. La línea masculina de la promesa.' },
  { id: 'patriarcas-madres-fundadoras', label: 'Madres fundadoras',           description: 'Era Patriarcal · Sara, Agar, Rebeca, Lea, Raquel. Las matriarcas cuya descendencia define a Israel y a los pueblos vecinos.' },
  { id: 'patriarcas-hijos-tribus',      label: 'Hijos y tribus',              description: 'Era Patriarcal · Hijos de los patriarcas que dan nombre a tribus o pueblos (Esaú/Edom, Benjamín).' },
  { id: 'patriarcas-vinculados',        label: 'Figuras vinculadas',          description: 'Era Patriarcal · Parientes, sobrinos y antepasados (Lot, Téraj, Nimrod) que rodean la saga abrahámica.' },
  { id: 'patriarcal',                   label: 'Patriarcas — Abraham y sus descendientes (legado)', description: 'Era Patriarcal · Bucket genérico previo a la subdivisión por roles.' },
  // ── Era Éxodo ──
  { id: 'exodo-liberadores',         label: 'Los liberadores',                description: 'Era Éxodo · Moisés, Aarón y Miriam. Los hermanos que enfrentan al Faraón y guían al pueblo.' },
  { id: 'exodo-faraones-y-egipcios', label: 'Faraones y egipcios',            description: 'Era Éxodo · El Faraón opresor, su hija salvadora, las parteras hebreas y los magos de la corte (Jannes y Jambres).' },
  { id: 'exodo-generacion-desierto', label: 'La generación del desierto',     description: 'Era Éxodo · Padres y suegros de Moisés (Amram, Jocabed, Séfora, Jetró), sacerdotes (Eleazar), rebeldes (Coré, Datán, Abiram) y artesanos del Tabernáculo.' },
  { id: 'exodo-conquista-canaan',    label: 'Conquista de Canaán',            description: 'Era Éxodo · Josué, Caleb y Rajab. La transición del desierto a la Tierra Prometida.' },
  { id: 'exodo',                     label: 'Éxodo de Egipto (legado)',       description: 'Era Éxodo · Bucket genérico previo a la subdivisión por roles.' },
  // ── Era Reinos y Exilio ──
  { id: 'reinos-jueces',             label: 'Jueces e Israel pre-monárquico', description: 'Era Reinos y Exilio · Débora, Barac, Gedeón, Sansón, Dalila, Samuel y los jueces tribales que preceden a la monarquía.' },
  { id: 'reinos-reyes',              label: 'Reyes de Israel y Judá',         description: 'Era Reinos y Exilio · Saúl, David, Salomón, Roboam, Jeroboam, Ajab, Jezabel y la corte (Natán, Joab, Urías, Betsabé). Aliados y enemigos (Goliat, Reina de Saba, Hiram).' },
  { id: 'reinos-profetas',           label: 'Profetas mayores',               description: 'Era Reinos y Exilio · Elías, Eliseo, Isaías, Jeremías, Ezequiel y Daniel. La voz crítica frente al poder.' },
  { id: 'reinos-exilio-y-retorno',   label: 'Exilio y retorno',               description: 'Era Reinos y Exilio · Nabucodonosor, Ciro, Darío, los tres jóvenes en el horno (Sadrac, Mesac, Abednego), Esdras y Zorobabel.' },
  { id: 'reinos-y-exilio',           label: 'Jueces, reyes y profetas (legado)', description: 'Era Reinos y Exilio · Bucket genérico previo a la subdivisión por roles.' },
  // ── Era Evangelio ──
  { id: 'evangelio-familia',             label: 'Jesús, su familia y la niñez',     description: 'Era Evangelio · Jesús de Nazaret, sus padres María y José, sus parientes (Juan Bautista, Isabel, Zacarías) y los ancianos que reconocen al niño en el Templo (Simeón, Ana).' },
  { id: 'evangelio-magos',               label: 'Los Reyes Magos y Herodes',        description: 'Era Evangelio · Los magos del Oriente que siguen la estrella (Melchor, Gaspar, Baltasar, según tradición) y Herodes el Grande, que reacciona ordenando la matanza de Belén.' },
  { id: 'evangelio-apostoles',           label: 'Los doce apóstoles y Pablo',       description: 'Era Evangelio · Los discípulos llamados directamente por Jesús (Pedro, Juan, Mateo, etc.) y Pablo de Tarso, apóstol de los gentiles.' },
  { id: 'evangelio-primeros-cristianos', label: 'Primeros cristianos y discípulos', description: 'Era Evangelio · La generación post-pascua: María Magdalena, las hermanas de Lázaro, Esteban (primer mártir), Bernabé, Lucas, Silas, Ananías, y otros protagonistas de Hechos.' },
  // ── Era Revelación ──
  { id: 'revelacion-familia-mahoma',  label: 'Familia del Profeta',           description: 'Era Revelación · Mahoma, sus padres (Abdullah, Amina), tíos (Abu Talib, Hamza), esposas (Jadiya, Aisha), hija Fátima, primo Alí, y allegados (Halima, Zayd).' },
  { id: 'revelacion-companeros',      label: 'Compañeros (Sahaba)',           description: 'Era Revelación · Los primeros conversos cercanos al Profeta: Abu Bakr, Omar, Bilal, Salman el Persa.' },
  { id: 'revelacion-opresores-meca',  label: 'Opresores de La Meca',          description: 'Era Revelación · Líderes de los Quraysh hostiles al mensaje: Abu Yahl, Abu Lahab, Abu Sufyán y Wahsi.' },
  { id: 'revelacion-ansar-medina',    label: 'Ansar y Medina',                description: 'Era Revelación · Los aliados de Medina que acogieron a los inmigrantes mecanos tras la Hégira.' },
  { id: 'revelacion-otros',           label: 'Figuras vinculadas y tradiciones', description: 'Era Revelación · Bahira, Waraqa, el Negus, el Buraq y los profetas anteriores que enmarcan la misión muhammadí.' },
  { id: 'revelacion',                 label: 'Mahoma y los primeros musulmanes (legado)', description: 'Era Revelación · Bucket genérico previo a la subdivisión por roles.' },
] as const;

function byBirth(a: any, b: any) {
  return (a.data.birthYear ?? 99999) - (b.data.birthYear ?? 99999);
}
const charsByGroup = new Map<string, typeof allChars>();
GROUPS.forEach((g) => {
  charsByGroup.set(g.id, allChars.filter((c) => c.data.group === g.id).sort(byBirth));
});
const ungrouped = allChars.filter((c) => !c.data.group);
---
<BaseLayout title="Personajes">
  <section class="px-6 py-16 max-w-6xl mx-auto">
    <h1 class="font-display text-4xl mb-2">Personajes</h1>
    <p class="opacity-70 mb-6">Vidas y menciones en las tres tradiciones — agrupados por linaje.</p>

    {GROUPS.map((group) => {
      const chars = charsByGroup.get(group.id) ?? [];
      if (chars.length === 0) return null;
      const eraId = GROUP_TO_ERA[group.id];
      const era = eraId ? erasById.get(eraId) : null;
      const accent = era?.palette.primary ?? 'var(--era-primary)';
      return (
        <div class="character-group mb-16" data-group-section data-section-era={eraId} style={`--group-accent: ${accent}`}>
          <header class="mb-6 border-b pb-3" style={`border-color: ${accent}55`}>
            <p class="text-[10px] tracking-[0.4em] uppercase opacity-50 mb-1" style={`color: ${accent}`}>
              {era ? `Era ${era.order} · ${era.name}` : 'Era'}
            </p>
            <h2 class="font-display text-2xl" style={`color: ${accent}`}>{group.label}</h2>
            <p class="text-sm opacity-70 mt-1">{group.description}</p>
          </header>
          <ul class="grid md:grid-cols-2 gap-6">
            {chars.map((c) => (
              <li class="border border-border rounded-lg p-5 hover:border-accent transition-colors" data-era={GROUP_TO_ERA[c.data.group ?? '']}>
                <a href={`/personajes/${c.data.id}`}>
                  <div class="flex items-start gap-4">
                    <PortraitPlaceholder name={c.data.name} src={c.data.portrait ?? undefined} avatar={c.data.avatar ?? undefined} size="md" />
                    <div class="flex-1">
                      <h3 class="font-display text-2xl">{c.data.name}</h3>
                      {c.data.alternateNames.meaning && (
                        <p class="text-sm md:text-base italic opacity-70 mt-2 font-display">"{c.data.alternateNames.meaning}"</p>
                      )}
                      <div class="lifespan-stats mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs">
                        {c.data.birthYear !== undefined && (
                          <span class="inline-flex items-baseline gap-1 opacity-80">
                            <span class="opacity-60 tracking-wider uppercase text-[10px]">★ Nació</span>
                            <span class="font-display text-sm">año {c.data.birthYear}</span>
                          </span>
                        )}
                        {c.data.deathYear !== undefined && (
                          <span class="inline-flex items-baseline gap-1 opacity-80">
                            <span class="opacity-60 tracking-wider uppercase text-[10px]">† Murió</span>
                            <span class="font-display text-sm">año {c.data.deathYear}</span>
                          </span>
                        )}
                        {c.data.ageAtDeath && (
                          <span class="inline-flex items-baseline gap-1 px-2 py-1 rounded-full border border-primary/40">
                            <span class="font-display text-base text-primary">{c.data.ageAtDeath}</span>
                            <span class="opacity-70 text-[10px] tracking-wider uppercase">años vividos</span>
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      );
    })}

    {ungrouped.length > 0 && (
      <div class="character-group mb-16">
        <header class="mb-6 border-b border-border pb-3">
          <h2 class="font-display text-2xl">Sin clasificar</h2>
        </header>
        <ul class="grid md:grid-cols-2 gap-6">
          {ungrouped.map((c) => (
            <li class="border border-border rounded-lg p-5">
              <a href={`/personajes/${c.data.id}`}>
                <h3 class="font-display text-2xl">{c.data.name}</h3>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</BaseLayout>

<script>
  const STORAGE_ID = 'biblia-last-era-id';
  const STORAGE_NAME = 'biblia-last-era-name';

  function applyFilter() {
    const eraId = localStorage.getItem(STORAGE_ID);
    const eraName = localStorage.getItem(STORAGE_NAME);
    const banner = document.querySelector<HTMLElement>('[data-era-filter-banner]');
    const eraLabelEl = document.querySelector<HTMLElement>('[data-era-filter-label]');
    const allItems = document.querySelectorAll<HTMLElement>('[data-era], [data-eras]');

    if (!eraId) {
      // Show everything
      banner?.classList.add('hidden');
      allItems.forEach((el) => el.classList.remove('hidden'));
      // Also un-hide section groups
      document.querySelectorAll<HTMLElement>('[data-group-section]').forEach((s) => s.classList.remove('hidden'));
      return;
    }

    // Show banner
    if (banner) banner.classList.remove('hidden');
    if (eraLabelEl && eraName) eraLabelEl.textContent = eraName;

    // Hide items not belonging to current era
    allItems.forEach((el) => {
      const itemEra = el.getAttribute('data-era');
      const itemEras = el.getAttribute('data-eras');
      let matches = false;
      if (itemEra) matches = itemEra === eraId;
      else if (itemEras) matches = itemEras.split(',').includes(eraId);
      el.classList.toggle('hidden', !matches);
    });

    // Hide group sections that have no visible items
    document.querySelectorAll<HTMLElement>('[data-group-section]').forEach((section) => {
      const sectionEra = section.getAttribute('data-section-era');
      if (sectionEra && sectionEra !== eraId) {
        section.classList.add('hidden');
      } else {
        section.classList.remove('hidden');
      }
    });
  }

  applyFilter();
  document.addEventListener('DOMContentLoaded', applyFilter);
</script>
