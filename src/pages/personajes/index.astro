---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PortraitPlaceholder from '../../components/PortraitPlaceholder.astro';
import { getCollection } from 'astro:content';

const allChars = await getCollection('characters');
const erasCollection = await getCollection('eras');
const erasById = new Map(erasCollection.map((e) => [e.data.id, e.data]));

const GROUP_TO_ERA: Record<string, string> = {
  'patriarcas': 'primordial',
  'linaje-set': 'primordial',
  'descendientes-cain': 'primordial',
  'vigilantes': 'primordial',
  'patriarcal': 'patriarcal',
  'exodo': 'exodo',
  'reinos-y-exilio': 'reinos-y-exilio',
  'evangelio': 'evangelio',
  'revelacion': 'revelacion',
};

const GROUPS = [
  // ── Era Primordial ──
  { id: 'patriarcas',         label: 'Patriarcas pre-diluvio',                description: 'Era Primordial · La línea de Adán hasta Noé y sus hijos, según las genealogías canónicas.' },
  { id: 'linaje-set',         label: 'Línea de Set',                          description: 'Era Primordial · Genealogía completa entre Set y Noé (Génesis 5).' },
  { id: 'descendientes-cain', label: 'Descendientes de Caín',                 description: 'Era Primordial · La rama paralela: los inventores de la civilización temprana.' },
  { id: 'vigilantes',         label: 'Vigilantes y figuras apócrifas',        description: 'Era Primordial · Ángeles caídos, Nephilim y tradiciones extra-bíblicas (Libro de Enoc, Cábala).' },
  // ── Era Patriarcal ──
  { id: 'patriarcal',         label: 'Patriarcas — Abraham y sus descendientes', description: 'Era Patriarcal · Abraham, Isaac, Jacob, José y las 12 tribus. Antepasados directos de las tres tradiciones.' },
  // ── Era Éxodo ──
  { id: 'exodo',              label: 'Éxodo de Egipto',                       description: 'Era Éxodo · Moisés, Aarón, Miriam y la generación del desierto. Los protagonistas de la liberación.' },
  // ── Era Reinos y Exilio ──
  { id: 'reinos-y-exilio',    label: 'Jueces, reyes y profetas',              description: 'Era Reinos y Exilio · De Josué a Daniel. Jueces, reyes (Saúl, David, Salomón), profetas mayores y el exilio babilónico.' },
  // ── Era Evangelio ──
  { id: 'evangelio',          label: 'Jesús, apóstoles y primeros cristianos', description: 'Era Evangelio · La familia de Jesús, los doce apóstoles, los protagonistas del Nuevo Testamento y la iglesia primitiva.' },
  // ── Era Revelación ──
  { id: 'revelacion',         label: 'Mahoma y los primeros musulmanes',      description: 'Era Revelación · El Profeta del islam, su familia, los Compañeros y los primeros conversos en La Meca y Medina.' },
] as const;

function byBirth(a: any, b: any) {
  return (a.data.birthYear ?? 99999) - (b.data.birthYear ?? 99999);
}
const charsByGroup = new Map<string, typeof allChars>();
GROUPS.forEach((g) => {
  charsByGroup.set(g.id, allChars.filter((c) => c.data.group === g.id).sort(byBirth));
});
const ungrouped = allChars.filter((c) => !c.data.group);
---
<BaseLayout title="Personajes">
  <section class="px-6 py-16 max-w-6xl mx-auto">
    <h1 class="font-display text-4xl mb-2">Personajes</h1>
    <p class="opacity-70 mb-6">Vidas y menciones en las tres tradiciones — agrupados por linaje.</p>

    <div class="era-filter-banner hidden flex items-center justify-between gap-4 mb-8 px-5 py-3 rounded-lg border border-accent/40 bg-surface/40" data-era-filter-banner>
      <p class="text-sm">
        <span class="opacity-70">Mostrando solo</span>
        <span class="font-display text-base mx-1">personajes</span>
        <span class="opacity-70">de</span>
        <span class="font-display text-base text-accent ml-1" data-era-filter-label>Era</span>
      </p>
      <button
        type="button"
        class="text-xs tracking-wider uppercase opacity-70 hover:opacity-100 hover:text-accent transition-opacity"
        data-era-filter-clear
      >
        Ver todas las eras →
      </button>
    </div>

    {GROUPS.map((group) => {
      const chars = charsByGroup.get(group.id) ?? [];
      if (chars.length === 0) return null;
      const eraId = GROUP_TO_ERA[group.id];
      const era = eraId ? erasById.get(eraId) : null;
      const accent = era?.palette.primary ?? 'var(--era-primary)';
      return (
        <div class="character-group mb-16" data-group-section data-section-era={eraId} style={`--group-accent: ${accent}`}>
          <header class="mb-6 border-b pb-3" style={`border-color: ${accent}55`}>
            <p class="text-[10px] tracking-[0.4em] uppercase opacity-50 mb-1" style={`color: ${accent}`}>
              {era ? `Era ${era.order} · ${era.name}` : 'Era'}
            </p>
            <h2 class="font-display text-2xl" style={`color: ${accent}`}>{group.label}</h2>
            <p class="text-sm opacity-70 mt-1">{group.description}</p>
          </header>
          <ul class="grid md:grid-cols-2 gap-6">
            {chars.map((c) => (
              <li class="border border-border rounded-lg p-5 hover:border-accent transition-colors" data-era={GROUP_TO_ERA[c.data.group ?? '']}>
                <a href={`/personajes/${c.data.id}`}>
                  <div class="flex items-start gap-4">
                    <PortraitPlaceholder name={c.data.name} src={c.data.portrait ?? undefined} avatar={c.data.avatar ?? undefined} size="md" />
                    <div class="flex-1">
                      <h3 class="font-display text-2xl">{c.data.name}</h3>
                      {c.data.alternateNames.meaning && (
                        <p class="text-sm md:text-base italic opacity-70 mt-2 font-display">"{c.data.alternateNames.meaning}"</p>
                      )}
                      <div class="lifespan-stats mt-4 flex flex-wrap items-center gap-x-4 gap-y-2 text-xs">
                        {c.data.birthYear !== undefined && (
                          <span class="inline-flex items-baseline gap-1 opacity-80">
                            <span class="opacity-60 tracking-wider uppercase text-[10px]">★ Nació</span>
                            <span class="font-display text-sm">año {c.data.birthYear}</span>
                          </span>
                        )}
                        {c.data.deathYear !== undefined && (
                          <span class="inline-flex items-baseline gap-1 opacity-80">
                            <span class="opacity-60 tracking-wider uppercase text-[10px]">† Murió</span>
                            <span class="font-display text-sm">año {c.data.deathYear}</span>
                          </span>
                        )}
                        {c.data.ageAtDeath && (
                          <span class="inline-flex items-baseline gap-1 px-2 py-1 rounded-full border border-primary/40">
                            <span class="font-display text-base text-primary">{c.data.ageAtDeath}</span>
                            <span class="opacity-70 text-[10px] tracking-wider uppercase">años vividos</span>
                          </span>
                        )}
                      </div>
                    </div>
                  </div>
                </a>
              </li>
            ))}
          </ul>
        </div>
      );
    })}

    {ungrouped.length > 0 && (
      <div class="character-group mb-16">
        <header class="mb-6 border-b border-border pb-3">
          <h2 class="font-display text-2xl">Sin clasificar</h2>
        </header>
        <ul class="grid md:grid-cols-2 gap-6">
          {ungrouped.map((c) => (
            <li class="border border-border rounded-lg p-5">
              <a href={`/personajes/${c.data.id}`}>
                <h3 class="font-display text-2xl">{c.data.name}</h3>
              </a>
            </li>
          ))}
        </ul>
      </div>
    )}
  </section>
</BaseLayout>

<script>
  const STORAGE_ID = 'biblia-last-era-id';
  const STORAGE_NAME = 'biblia-last-era-name';

  function applyFilter() {
    const eraId = localStorage.getItem(STORAGE_ID);
    const eraName = localStorage.getItem(STORAGE_NAME);
    const banner = document.querySelector<HTMLElement>('[data-era-filter-banner]');
    const eraLabelEl = document.querySelector<HTMLElement>('[data-era-filter-label]');
    const allItems = document.querySelectorAll<HTMLElement>('[data-era], [data-eras]');

    if (!eraId) {
      // Show everything
      banner?.classList.add('hidden');
      allItems.forEach((el) => el.classList.remove('hidden'));
      // Also un-hide section groups
      document.querySelectorAll<HTMLElement>('[data-group-section]').forEach((s) => s.classList.remove('hidden'));
      return;
    }

    // Show banner
    if (banner) banner.classList.remove('hidden');
    if (eraLabelEl && eraName) eraLabelEl.textContent = eraName;

    // Hide items not belonging to current era
    allItems.forEach((el) => {
      const itemEra = el.getAttribute('data-era');
      const itemEras = el.getAttribute('data-eras');
      let matches = false;
      if (itemEra) matches = itemEra === eraId;
      else if (itemEras) matches = itemEras.split(',').includes(eraId);
      el.classList.toggle('hidden', !matches);
    });

    // Hide group sections that have no visible items
    document.querySelectorAll<HTMLElement>('[data-group-section]').forEach((section) => {
      const sectionEra = section.getAttribute('data-section-era');
      if (sectionEra && sectionEra !== eraId) {
        section.classList.add('hidden');
      } else {
        section.classList.remove('hidden');
      }
    });
  }

  const clearBtn = document.querySelector<HTMLButtonElement>('[data-era-filter-clear]');
  clearBtn?.addEventListener('click', () => {
    localStorage.removeItem(STORAGE_ID);
    localStorage.removeItem(STORAGE_NAME);
    applyFilter();
  });

  applyFilter();
  document.addEventListener('DOMContentLoaded', applyFilter);
</script>
