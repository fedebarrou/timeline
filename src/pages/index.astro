---
import BaseLayout from '../layouts/BaseLayout.astro';
import LogoParticles from '../components/LogoParticles.astro';
import { getCollection } from 'astro:content';

const eras = (await getCollection('eras')).sort((a, b) => a.data.order - b.data.order);
const events = await getCollection('events');
const eventsByEra = new Map<string, number>();
events.forEach((e) => {
  eventsByEra.set(e.data.era, (eventsByEra.get(e.data.era) ?? 0) + 1);
});
---
<BaseLayout title="Línea de Tiempo · Adán → Mahoma">
  {/* Hero: single full-bleed canvas. Logo 1 (apple) lives at top-left,
       logo 2 at bottom-right. Both assemble, then their particles mix
       together in the centre, then they reassemble at their anchors.
       Slow & premium — full cycle ~26s. */}
  <section class="hero relative min-h-[80vh] flex flex-col items-center justify-center text-center px-6 overflow-hidden">
    <div
      class="hero-bg absolute inset-0 -z-10 pointer-events-none"
      style="background: var(--era-bg-gradient, var(--era-bg));"
    >
      <LogoParticles
        src="/images/logo.png"
        src2="/images/logo2.png"
        step={10}
        dotRadius={1.1}
        dotOpacity={0.78}
        lineOpacity={0.25}
        linkDistance={18}
        maxLinksPerParticle={2}
        anchor1={[0.25, 0.40]}
        anchor2={[0.75, 0.60]}
        silhouetteScale={0.88}
        cycleSeconds={32}
        windStrength={1.5}
        class="absolute inset-0"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-transparent via-transparent to-bg/95"></div>
    </div>
    <p class="text-xs tracking-[0.4em] uppercase opacity-60 mb-6">Línea de tiempo</p>
    <h1 class="font-display text-5xl md:text-7xl mb-4">Adán → Mahoma</h1>
    <p class="max-w-2xl text-lg opacity-80 leading-relaxed">
      Un viaje visual por los relatos de la Torá, la Biblia y el Corán —
      comparando, contrastando y mapeando 4.500 años de historia sagrada.
    </p>
    <p class="mt-8 text-xs opacity-60 tracking-wider">
      6 eras · 3 tradiciones · 4.500 años · Elegí desde dónde empezar
    </p>
  </section>

  <section class="eras-grid py-16 px-6 max-w-7xl mx-auto">
    <h2 class="font-display text-2xl mb-10 opacity-80 text-center">Eras</h2>
    <div class="grid md:grid-cols-2 lg:grid-cols-3 gap-6">
      {eras.map((era) => {
        const count = eventsByEra.get(era.data.id) ?? 0;
        const available = count > 0;
        const Tag = available ? 'a' : 'div';
        return (
          <Tag
            href={available ? `/era/${era.data.id}` : undefined}
            class={`era-card relative block rounded-lg overflow-hidden border ${available ? 'border-border hover:border-accent cursor-pointer' : 'border-border/40 opacity-60'} transition-all`}
            style={`background: ${era.data.palette.bgGradient}; color: ${era.data.palette.text};`}
          >
            <div class="p-6 min-h-[220px] flex flex-col justify-between">
              <div>
                <p class="text-[10px] tracking-[0.3em] uppercase opacity-60 mb-3" style={`color: ${era.data.palette.primary}`}>Era {era.data.order}</p>
                <h3 class="font-display text-3xl mb-1 uppercase tracking-wider" style={`font-family: ${era.data.typography.display}; color: ${era.data.palette.primary}`}>{era.data.name}</h3>
                <p class="italic opacity-70 text-sm" style={`color: ${era.data.palette.text}`}>{era.data.tagline}</p>
              </div>
              <div class="flex items-end justify-between mt-6">
                <p class="text-xs opacity-60">
                  Año {era.data.yearRange.from}–{era.data.yearRange.to}
                </p>
                {available ? (
                  <span class="text-xs tracking-wider uppercase" style={`color: ${era.data.palette.accent}`}>{count} eventos →</span>
                ) : (
                  <span class="text-[10px] tracking-wider uppercase px-2 py-1 border border-current opacity-60 rounded">Próximamente</span>
                )}
              </div>
            </div>
          </Tag>
        );
      })}
    </div>
  </section>
</BaseLayout>
