---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import EventScene from '../../components/EventScene.astro';
import ManuscriptMap from '../../components/ManuscriptMap.astro';
import ModernMapLayer from '../../components/ModernMapLayer.astro';
import MapToggleButton from '../../components/MapToggleButton.astro';
import EraTheme from '../../components/EraTheme.astro';
import TimelineNav from '../../components/TimelineNav.astro';
import PlayButton from '../../components/PlayButton.astro';
import VoiceSettings from '../../components/VoiceSettings.astro';

export async function getStaticPaths() {
  const eras = await getCollection('eras');
  const events = await getCollection('events');
  return eras
    .filter((era) => events.some((e) => e.data.era === era.data.id))
    .map((era) => ({ params: { id: era.data.id }, props: { era } }));
}

const { era } = Astro.props;
const allEvents = await getCollection('events');
const events = allEvents
  .filter((e) => e.data.era === era.data.id)
  .sort((a, b) => a.data.order - b.data.order);
const eras = [era];
const allEras = await getCollection('eras');

// Compute jittered svgPositions so overlapping markers are visually distinct
const seenPositions = new Map<string, number>();
const jitteredPositions = new Map<string, [number, number]>();
events.forEach((e) => {
  const loc = e.data.locations[0];
  if (!loc) return;
  const original: [number, number] = loc.svgPosition;
  const key = `${original[0]},${original[1]}`;
  const count = seenPositions.get(key) ?? 0;
  let pos: [number, number] = original;
  if (count > 0) {
    const angle = (count - 1) * (Math.PI / 4);
    const radius = 8 + Math.floor((count - 1) / 8) * 8;
    pos = [original[0] + Math.cos(angle) * radius, original[1] + Math.sin(angle) * radius];
  }
  jitteredPositions.set(e.data.id, pos);
  seenPositions.set(key, count + 1);
});

const sceneConfigs = events.map((e) => {
  const primaryLoc = e.data.locations[0];
  const locById = new Map(e.data.locations.map((l: { id: string; svgPosition: [number, number] }) => [l.id, l.svgPosition]));
  const journeys = (e.data.journey ?? []).map((j: { from: string; to: string; style: string }) => {
    const from = locById.get(j.from);
    const to = locById.get(j.to);
    if (!from || !to) return null;
    return { from, to, style: j.style };
  }).filter(Boolean);
  return {
    eventId: e.data.id,
    eraId: e.data.era,
    svgPosition: jitteredPositions.get(e.data.id) ?? primaryLoc?.svgPosition ?? [500, 300],
    coords: primaryLoc?.coords,
    modernName: primaryLoc?.modernName ?? primaryLoc?.ancientName,
    journeys,
  };
});

const allMarkers = events.map((e) => {
  const loc = e.data.locations[0];
  if (!loc) return null;
  return {
    id: e.data.id,
    svgPosition: jitteredPositions.get(e.data.id) ?? loc.svgPosition,
    label: e.data.title + (loc.ancientName ? ` (${loc.ancientName})` : ''),
    coords: loc.coords,
    characterIds: (e.data.characters ?? []).map((c: { id: string }) => c.id),
  };
}).filter(Boolean);
---
<BaseLayout title={`${era.data.name} · Línea de tiempo`} navTitle={`Era · ${era.data.name}`}>
  <style>main { padding-top: 7rem !important; }</style>
  <EraTheme era={era} />
  <TimelineNav events={events} eras={eras} allEras={allEras} currentEraId={era.data.id} />

  <div class="relative">
    <div class="map-sticky hidden md:block fixed top-[7rem] right-0 w-[55%] md:w-[50%] lg:w-[60%] h-[calc(100vh-7rem)]">
      <ManuscriptMap />
      <ModernMapLayer />
      <MapToggleButton />
    </div>

    <div class="scenes">
      {events.map((event) => <EventScene event={event} />)}
    </div>
  </div>

  <script type="application/json" id="map-data" set:html={JSON.stringify({ sceneConfigs, allMarkers })}></script>

  <script>
    import { initScrollytelling } from '../../lib/sceneController';
    import { renderMarker } from '../../lib/mapMarkers';
    import { registerMarkers } from '../../lib/mapToggle';

    const dataEl = document.getElementById('map-data');
    if (dataEl) {
      const { sceneConfigs, allMarkers } = JSON.parse(dataEl.textContent || '{}');
      const svg = document.querySelector('[data-map-root]') as SVGSVGElement | null;
      if (svg) {
        allMarkers.forEach((m: any) => renderMarker(svg, m));
      }
      registerMarkers(allMarkers.filter((m: any) => m.coords).map((m: any) => ({
        id: m.id, coords: m.coords, label: m.label,
      })));
      initScrollytelling(sceneConfigs);
    }
  </script>

  <script>
    import { initNarrators } from '../../lib/narratorWiring';
    document.addEventListener('DOMContentLoaded', initNarrators);
    if (document.readyState !== 'loading') initNarrators();
  </script>

  <PlayButton />
  <VoiceSettings />
</BaseLayout>
