---
interface Props {
  eventId: string;
  narrationText: string; // extracted plain text for narration
  /**
   * Optional URL of a pre-generated MP3 narration. When provided, the
   * narrator uses HTMLAudioElement playback instead of Web Speech API.
   * Generated by `scripts/generate-narrations.mjs` and served from
   * `/public/audio/{eventId}.mp3`.
   */
  audioSrc?: string | null;
}
const { eventId, narrationText, audioSrc } = Astro.props;

/**
 * Tokenize the narration text into word spans. We keep the running
 * character offset of each token so the boundary handler can locate the
 * active word via `charIndex`. Whitespace tokens are emitted as plain
 * text so original formatting (spaces, line breaks) is preserved.
 */
type Token = { kind: 'word' | 'space'; text: string; start: number; end: number };
function tokenize(text: string): Token[] {
  const tokens: Token[] = [];
  const re = /(\s+|[^\s]+)/g;
  let m: RegExpExecArray | null;
  while ((m = re.exec(text)) !== null) {
    const tok = m[0];
    const start = m.index;
    const end = start + tok.length;
    tokens.push({ kind: /^\s+$/.test(tok) ? 'space' : 'word', text: tok, start, end });
  }
  return tokens;
}
const tokens = tokenize(narrationText);
---
<div
  class="narrator-control mt-4 mb-6"
  data-narrator
  data-event-id={eventId}
  data-audio-src={audioSrc ?? ''}
>
  <div class="flex items-center gap-2">
    <button
      type="button"
      class="narrator-play px-3 py-2 rounded-full border border-border bg-surface/60 hover:border-accent text-sm tracking-wider uppercase flex items-center gap-2 transition-colors"
      data-narrator-play
      aria-label="Leer narración"
    >
      <span class="play-icon" data-state="paused">▶</span>
      <span class="label">Escuchar</span>
    </button>
    <div class="narrator-progress flex-1 h-1 bg-border/40 rounded-full overflow-hidden hidden" data-narrator-progress-wrap>
      <div class="h-full bg-accent transition-[width] duration-150" style="width: 0%" data-narrator-progress></div>
    </div>
  </div>

  {/* Hidden audio element — used when audioSrc is provided.
       `preload="metadata"` ensures the browser has at least the headers
       (and ideally some buffered data) ready when the user clicks
       "Escuchar", so `audio.play()` resolves promptly. With `preload="none"`
       the first click triggers a network fetch and `play()` stays pending
       — if the user clicks Stop while it's still loading, the audio can
       start AFTER the stop request (the resolved promise wins the race),
       producing the "silence on click 1, sound on click 2" bug. */}
  {audioSrc && (
    <audio
      preload="metadata"
      data-narrator-audio
      src={audioSrc}
      crossorigin="anonymous"
    ></audio>
  )}

  {/* Word-by-word display — appears while narration is active */}
  <div
    class="narration-display hidden mt-4 p-4 rounded-lg border border-border bg-surface/40 text-lg leading-relaxed"
    data-narration-display
  >
    {tokens.map((t) => (
      t.kind === 'word'
        ? <span class="word" data-word data-start={t.start} data-end={t.end}>{t.text}</span>
        : <span set:html={t.text.replace(/\n/g, '<br/>')} />
    ))}
  </div>
</div>

<script type="application/json" data-narration-text data-event-id={eventId} set:html={JSON.stringify(narrationText)}></script>

<script>
  /* Self-contained narrator wiring per component instance.
     This mirrors the PlayButton pattern: each component owns its own
     script. Avoids the dependency on a global `initNarrators()` call
     that wasn't firing reliably under Vite dev. */
  import { speak, onProgress, onEnd, onBoundary, cancelAllNarration } from '../lib/tts';

  document.querySelectorAll<HTMLElement>('[data-narrator]').forEach((ctrl) => {
    if ((ctrl as any).__wired) return;       // idempotent
    (ctrl as any).__wired = true;

    const id = ctrl.dataset.eventId!;
    const audioSrc = ctrl.dataset.audioSrc || '';
    const btn = ctrl.querySelector<HTMLButtonElement>('[data-narrator-play]');
    const icon = ctrl.querySelector<HTMLElement>('.play-icon');
    const label = ctrl.querySelector<HTMLElement>('.label');
    const progressWrap = ctrl.querySelector<HTMLElement>('[data-narrator-progress-wrap]');
    const progress = ctrl.querySelector<HTMLElement>('[data-narrator-progress]');
    const display = ctrl.querySelector<HTMLElement>('[data-narration-display]');
    const audioEl = ctrl.querySelector<HTMLAudioElement>('[data-narrator-audio]');
    const wordEls = display ? Array.from(display.querySelectorAll<HTMLElement>('[data-word]')) : [];
    const textScript = document.querySelector<HTMLScriptElement>(`script[data-narration-text][data-event-id="${id}"]`);
    if (!btn || !icon || !label || !textScript || !progress || !progressWrap) return;

    let text = '';
    try { text = JSON.parse(textScript.textContent || '""'); } catch {}

    const useAudio = Boolean(audioSrc && audioEl);
    let session = 0;

    // Pre-compute punctuation-weighted CDF for accurate word highlight under audio mode.
    function weightOf(ch: string): number {
      if (ch === '.' || ch === '!' || ch === '?') return 10;
      if (ch === ';' || ch === ':') return 6;
      if (ch === ',') return 4;
      if (ch === ' ') return 0.6;
      if (ch === '\n') return 8;
      return 1;
    }
    const cumW: number[] = new Array(text.length + 1);
    cumW[0] = 0;
    for (let i = 0; i < text.length; i++) cumW[i + 1] = cumW[i] + weightOf(text[i]);
    const totalW = cumW[text.length] || 1;
    function fracToCharIdx(frac: number): number {
      const target = Math.max(0, Math.min(1, frac)) * totalW;
      let lo = 0, hi = cumW.length - 1;
      while (lo < hi) { const mid = (lo + hi) >>> 1; if (cumW[mid] < target) lo = mid + 1; else hi = mid; }
      return Math.max(0, lo - 1);
    }

    function resetWords() {
      wordEls.forEach((w) => w.classList.remove('spoken-past', 'spoken-current'));
    }
    function highlightAt(charIndex: number) {
      if (wordEls.length === 0) return;
      let activeIdx = -1;
      for (let i = 0; i < wordEls.length; i++) {
        const start = parseInt(wordEls[i].dataset.start || '0', 10);
        const end = parseInt(wordEls[i].dataset.end || '0', 10);
        if (charIndex >= start && charIndex < end) { activeIdx = i; break; }
        if (start > charIndex) { activeIdx = Math.max(i - 1, 0); break; }
      }
      if (activeIdx === -1) activeIdx = wordEls.length - 1;
      wordEls.forEach((w, i) => {
        w.classList.toggle('spoken-past', i < activeIdx);
        w.classList.toggle('spoken-current', i === activeIdx);
      });
      const active = wordEls[activeIdx];
      if (active) {
        const rect = active.getBoundingClientRect();
        if (rect.top < 80 || rect.bottom > window.innerHeight - 80) {
          active.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }
      }
    }
    function setIdleUi() {
      icon!.textContent = '▶'; icon!.dataset.state = 'paused';
      label!.textContent = 'Escuchar';
      progressWrap!.classList.add('hidden');
      progress!.style.width = '0%';
      display?.classList.add('hidden');
      resetWords();
    }
    function setPlayingUi() {
      icon!.textContent = '■'; icon!.dataset.state = 'playing';
      label!.textContent = 'Detener';
      progressWrap!.classList.remove('hidden');
      display?.classList.remove('hidden');
      resetWords();
    }
    function stop() {
      session++;
      cancelAllNarration();
      onBoundary(null);
      setIdleUi();
    }

    // Estimated narration duration for the TTS fallback path (no real
     // audio file). ~150 wpm = 2.5 wps; this is rough but enough to drive
     // a "remaining time" indicator. Words = whitespace-separated tokens.
    const estimatedDuration = Math.max(2, text.split(/\s+/).filter(Boolean).length / 2.5);

    function dispatchTick(current: number, duration: number) {
      window.dispatchEvent(new CustomEvent('timeline:narration-tick', {
        detail: { eventId: id, current, duration },
      }));
    }
    function dispatchBoundary(charIndex: number) {
      window.dispatchEvent(new CustomEvent('timeline:narration-boundary', {
        detail: { eventId: id, charIndex },
      }));
    }
    function dispatchEnded() {
      window.dispatchEvent(new CustomEvent('timeline:narration-ended', {
        detail: { eventId: id },
      }));
    }

    let audioTickBound = false;
    function bindAudioOnce() {
      if (audioTickBound || !audioEl) return;
      audioTickBound = true;
      // The audio element is shared with playMode (which plays it via
      // .play() directly when "Reproducir era" is active). If we wait
      // until the user clicks "Escuchar" here, those listeners never
      // bind for the global-play path → no boundary/tick events fire →
      // no fullscreen text highlight, no narration cues. So we bind on
      // mount instead (this function is idempotent via audioTickBound).
      audioEl.addEventListener('timeupdate', () => {
        if (!audioEl.duration || !isFinite(audioEl.duration)) return;
        const p = Math.min(1, Math.max(0, audioEl.currentTime / audioEl.duration));
        progress!.style.width = `${(p * 100).toFixed(1)}%`;
        const charIdx = fracToCharIdx(p);
        highlightAt(charIdx);
        dispatchTick(audioEl.currentTime, audioEl.duration);
        dispatchBoundary(charIdx);
      });
      audioEl.addEventListener('loadedmetadata', () => {
        if (audioEl.duration && isFinite(audioEl.duration)) {
          dispatchTick(0, audioEl.duration);
        }
      });
      audioEl.addEventListener('ended', () => {
        progress!.style.width = '100%';
        wordEls.forEach((w) => { w.classList.remove('spoken-current'); w.classList.add('spoken-past'); });
        dispatchEnded();
        setTimeout(setIdleUi, 800);
      });
      audioEl.addEventListener('error', () => {
        console.warn('[narrator] audio error — clearing src so next click uses TTS');
        audioEl.removeAttribute('src');
        setIdleUi();
      });
    }

    function speakFallback(mySession: number) {
      if (mySession !== session) return;
      setPlayingUi();
      // Seed the timer with the estimate so the panel shows a total
      // immediately, before the first onProgress fires.
      dispatchTick(0, estimatedDuration);
      onProgress((p) => {
        if (mySession !== session) return;
        progress!.style.width = `${(p * 100).toFixed(1)}%`;
        dispatchTick(p * estimatedDuration, estimatedDuration);
      });
      onBoundary((charIndex) => {
        if (mySession !== session) return;
        highlightAt(charIndex);
        dispatchBoundary(charIndex);
      });
      onEnd(() => {
        if (mySession !== session) return;
        progress!.style.width = '100%';
        wordEls.forEach((w) => { w.classList.remove('spoken-current'); w.classList.add('spoken-past'); });
        onBoundary(null);
        dispatchEnded();
        setTimeout(() => { if (mySession === session) setIdleUi(); }, 800);
      });
      speak(text);
    }

    btn.addEventListener('click', () => {
      console.log('[narrator] click', id, { useAudio, audioSrc, hasAudioEl: !!audioEl, state: icon!.dataset.state });
      if (icon!.dataset.state === 'playing') { stop(); return; }
      const mySession = ++session;
      cancelAllNarration(audioEl ?? null);
      document.querySelectorAll<HTMLElement>('[data-narrator]').forEach((other) => {
        if (other === ctrl) return;
        const oIcon = other.querySelector<HTMLElement>('.play-icon');
        const oLabel = other.querySelector<HTMLElement>('.label');
        const oProg = other.querySelector<HTMLElement>('[data-narrator-progress-wrap]');
        const oDisp = other.querySelector<HTMLElement>('[data-narration-display]');
        if (oIcon) { oIcon.textContent = '▶'; oIcon.dataset.state = 'paused'; }
        if (oLabel) oLabel.textContent = 'Escuchar';
        oProg?.classList.add('hidden');
        oDisp?.classList.add('hidden');
        other.querySelectorAll<HTMLElement>('[data-word]').forEach((w) =>
          w.classList.remove('spoken-past', 'spoken-current'));
      });
      if (useAudio && audioEl && audioEl.getAttribute('src')) {
        bindAudioOnce();
        setPlayingUi();
        const p = audioEl.play();
        if (p && typeof p.catch === 'function') {
          p.catch((err) => {
            if (mySession !== session) return;
            console.warn('[narrator] audio.play() rejected, fallback to TTS', err);
            speakFallback(mySession);
          });
        }
      } else {
        speakFallback(mySession);
      }
    });

    // Bind audio listeners at mount so global play mode (which calls
    // audio.play() directly from playMode.ts) also fires timeline:narration-*
    // events. The function is idempotent.
    if (useAudio) bindAudioOnce();

    /*
     * Cross-scene narration mutex.
     *  - Scrolling / clicking the timeline dot / arrow keys to a different
     *    event must stop the still-running narration of the event the user
     *    just left. Without this, "Escuchar" on A + scroll to B leaves
     *    A's voice droning over B's content.
     *  - On the FLIP side, when "Reproducir era" advances to OUR scene,
     *    playMode plays our <audio> directly but never opens our
     *    `[data-narration-display]` panel — so the per-word highlight is
     *    happening on a hidden panel and the user perceives "no color
     *    change". Force-show the panel when the active scene matches.
     */
    window.addEventListener('timeline:scene-changed', (e) => {
      const newId = (e as CustomEvent).detail?.eventId;
      if (!newId) return;
      if (newId !== id) {
        // A different scene is now active. If WE were reading, stop.
        if (icon!.dataset.state === 'playing') stop();
        // Either way, collapse our display so only the active scene's
        // panel is on screen at a time.
        display?.classList.add('hidden');
        progressWrap?.classList.add('hidden');
        resetWords();
      } else {
        // OUR scene is active. If global era-play is running, reveal the
        // display so the word-by-word highlight is visible during the
        // playMode-driven audio playback.
        const eraPlayActive = document
          .querySelector<HTMLElement>('[data-play-mode] .play-icon')
          ?.dataset.state === 'playing';
        if (eraPlayActive) {
          display?.classList.remove('hidden');
          progressWrap?.classList.remove('hidden');
        }
      }
    });
  });

  /* Page navigation safety net — Web Speech doesn't always stop on
     unload (crbug.com/717541 and friends), and the era nav on this site
     is a full page navigation between /era/X and /era/Y. Cancel any
     in-flight narration before the browser tears down the document. */
  if (typeof window !== 'undefined') {
    const stopAll = () => {
      try { if ('speechSynthesis' in window) speechSynthesis.cancel(); } catch {}
      document.querySelectorAll<HTMLAudioElement>('audio[data-narrator-audio]').forEach((a) => {
        try { if (!a.paused) { a.pause(); a.currentTime = 0; } } catch {}
      });
    };
    window.addEventListener('pagehide', stopAll);
    window.addEventListener('beforeunload', stopAll);
  }
</script>

<style>
  /* Word states during narration */
  .narration-display .word { transition: background-color 120ms ease, color 120ms ease, opacity 120ms ease; padding: 0 1px; border-radius: 2px; }
  .narration-display .word.spoken-past { opacity: 0.45; }
  .narration-display .word.spoken-current {
    background: var(--era-accent);
    color: var(--era-bg);
    font-weight: 600;
    opacity: 1;
  }
</style>
