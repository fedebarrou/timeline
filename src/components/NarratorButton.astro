---
interface Props {
  eventId: string;
  narrationText: string; // extracted plain text for narration
}
const { eventId, narrationText } = Astro.props;
---
<div class="narrator-control flex items-center gap-2 mt-4" data-narrator data-event-id={eventId}>
  <button
    type="button"
    class="narrator-play px-3 py-2 rounded-full border border-border bg-surface/60 hover:border-accent text-xs tracking-wider uppercase flex items-center gap-2 transition-colors"
    data-narrator-play
    aria-label="Leer narración"
  >
    <span class="play-icon" data-state="paused">▶</span>
    <span class="label">Escuchar</span>
  </button>
  <div class="narrator-progress flex-1 h-1 bg-border/40 rounded-full overflow-hidden hidden" data-narrator-progress-wrap>
    <div class="h-full bg-accent" style="width: 0%" data-narrator-progress></div>
  </div>
</div>
<script type="application/json" data-narration-text data-event-id={eventId} set:html={JSON.stringify(narrationText)}></script>
