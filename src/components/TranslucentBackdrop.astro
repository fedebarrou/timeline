---
interface Props {
  src?: string | null;
  alt?: string;
}
const { src, alt = '' } = Astro.props;
---
{src && (
  <div class="translucent-backdrop" aria-hidden="true">
    <img src={src} alt={alt} loading="lazy" />
  </div>
)}

<style>
  .translucent-backdrop {
    position: fixed;
    top: 4rem;
    right: 0;
    width: 65vw;
    height: calc(100vh - 4rem);
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    /* Semi-circular fade — ellipse centered on the right edge.
       The image is "solid" on the right and fades out elliptically toward the left. */
    -webkit-mask-image: radial-gradient(
      ellipse 75% 95% at 100% 50%,
      rgba(0,0,0,1) 0%,
      rgba(0,0,0,1) 30%,
      rgba(0,0,0,0.85) 55%,
      rgba(0,0,0,0.4) 78%,
      rgba(0,0,0,0.12) 90%,
      transparent 100%
    );
            mask-image: radial-gradient(
      ellipse 75% 95% at 100% 50%,
      rgba(0,0,0,1) 0%,
      rgba(0,0,0,1) 30%,
      rgba(0,0,0,0.85) 55%,
      rgba(0,0,0,0.4) 78%,
      rgba(0,0,0,0.12) 90%,
      transparent 100%
    );
  }
  /* Extra blending: solid era-bg color fading from edges inward.
     The radial gradient + the era-bg overlay create a full dissolve into the page. */
  .translucent-backdrop::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(
        ellipse 80% 100% at 100% 50%,
        transparent 0%,
        transparent 35%,
        var(--era-bg) 95%
      );
    z-index: 1;
    pointer-events: none;
  }
  .translucent-backdrop img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
    opacity: 0.6;
    filter: blur(0.4px) saturate(0.9);
  }
  @media (max-width: 768px) {
    .translucent-backdrop { width: 85vw; }
    .translucent-backdrop img { opacity: 0.32; }
  }
</style>
