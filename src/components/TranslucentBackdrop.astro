---
interface Props {
  src?: string | null;
  alt?: string;
}
const { src, alt = '' } = Astro.props;
---
{src && (
  <div class="translucent-backdrop" aria-hidden="true">
    <img src={src} alt={alt} loading="lazy" />
  </div>
)}

<style>
  .translucent-backdrop {
    position: fixed;
    top: 4rem;
    right: 0;
    width: 65vw;
    height: calc(100vh - 4rem);
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
  }
  /* Layer 1: image with object-fit contain so the full body shows */
  .translucent-backdrop img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right center;
    opacity: 0.7;
    /* CSS mask applied directly to the image — fades the image's alpha channel */
    -webkit-mask-image: radial-gradient(
      ellipse 60% 90% at 100% 50%,
      rgba(0,0,0,1) 0%,
      rgba(0,0,0,1) 25%,
      rgba(0,0,0,0.8) 45%,
      rgba(0,0,0,0.35) 65%,
      rgba(0,0,0,0.1) 82%,
      transparent 95%
    );
            mask-image: radial-gradient(
      ellipse 60% 90% at 100% 50%,
      rgba(0,0,0,1) 0%,
      rgba(0,0,0,1) 25%,
      rgba(0,0,0,0.8) 45%,
      rgba(0,0,0,0.35) 65%,
      rgba(0,0,0,0.1) 82%,
      transparent 95%
    );
    filter: blur(0.4px) saturate(0.9);
  }
  /* Layer 2: solid era-bg color overlay that fades from left edge inward,
     hiding any remaining hard edge of the image */
  .translucent-backdrop::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to right,
      var(--era-bg) 0%,
      var(--era-bg) 25%,
      rgba(0,0,0,0) 65%,
      rgba(0,0,0,0) 100%
    );
    z-index: 2;
    pointer-events: none;
  }
  /* Layer 3: subtle vertical fade for top/bottom edges */
  .translucent-backdrop::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, var(--era-bg) 0%, transparent 12%, transparent 88%, var(--era-bg) 100%);
    z-index: 3;
    pointer-events: none;
  }
  @media (max-width: 768px) {
    .translucent-backdrop { width: 85vw; }
    .translucent-backdrop img { opacity: 0.4; }
  }
</style>
