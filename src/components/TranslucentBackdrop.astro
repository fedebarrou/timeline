---
interface Props {
  src?: string | null;
  alt?: string;
}
const { src, alt = '' } = Astro.props;
---
{src && (
  <div class="translucent-backdrop" aria-hidden="true">
    <img src={src} alt={alt} loading="lazy" />
  </div>
)}

<style>
  .translucent-backdrop {
    position: fixed;
    top: 4rem;
    right: 0;
    width: 55vw;
    height: calc(100vh - 4rem);
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    /* feather edges using mask + gradient */
    -webkit-mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0,0,0,0.85) 28%,
      rgba(0,0,0,1) 55%,
      rgba(0,0,0,0.85) 85%,
      transparent 100%
    );
    mask-image: linear-gradient(
      to right,
      transparent 0%,
      rgba(0,0,0,0.85) 28%,
      rgba(0,0,0,1) 55%,
      rgba(0,0,0,0.85) 85%,
      transparent 100%
    );
  }
  .translucent-backdrop::before {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(to bottom, var(--era-bg) 0%, transparent 12%, transparent 88%, var(--era-bg) 100%);
    z-index: 1;
    pointer-events: none;
  }
  .translucent-backdrop img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center;
    opacity: 0.42;
    filter: blur(0.3px) saturate(0.9);
  }
  @media (max-width: 768px) {
    .translucent-backdrop {
      width: 80vw;
      opacity: 0.7;
    }
    .translucent-backdrop img { opacity: 0.25; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .translucent-backdrop img {
      transition: opacity 800ms ease;
    }
  }
</style>
