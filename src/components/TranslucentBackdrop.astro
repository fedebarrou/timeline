---
interface Props {
  src?: string | null;
  alt?: string;
}
const { src, alt = '' } = Astro.props;
---
{src && (
  <div class="translucent-backdrop" aria-hidden="true">
    <img src={src} alt={alt} loading="lazy" />
  </div>
)}

<style>
  .translucent-backdrop {
    position: fixed;
    top: 4rem;
    right: 0;
    width: 60vw;
    height: calc(100vh - 4rem);
    z-index: 0;
    pointer-events: none;
    overflow: hidden;
    /* Aggressive horizontal AND vertical mask so all edges fade to transparent */
    -webkit-mask-image:
      linear-gradient(to left,
        transparent 0%,
        rgba(0,0,0,0.4) 8%,
        rgba(0,0,0,1) 35%,
        rgba(0,0,0,1) 65%,
        rgba(0,0,0,0.4) 92%,
        transparent 100%),
      linear-gradient(to top,
        transparent 0%,
        rgba(0,0,0,1) 18%,
        rgba(0,0,0,1) 82%,
        transparent 100%);
    -webkit-mask-composite: source-in;
            mask-image:
      linear-gradient(to left,
        transparent 0%,
        rgba(0,0,0,0.4) 8%,
        rgba(0,0,0,1) 35%,
        rgba(0,0,0,1) 65%,
        rgba(0,0,0,0.4) 92%,
        transparent 100%),
      linear-gradient(to top,
        transparent 0%,
        rgba(0,0,0,1) 18%,
        rgba(0,0,0,1) 82%,
        transparent 100%);
            mask-composite: intersect;
  }
  /* Era-bg color soft halo on top and bottom (extra blending into page bg) */
  .translucent-backdrop::before {
    content: '';
    position: absolute;
    inset: 0;
    background:
      linear-gradient(to bottom, var(--era-bg) 0%, transparent 18%, transparent 82%, var(--era-bg) 100%),
      linear-gradient(to left, transparent 0%, transparent 65%, var(--era-bg) 100%);
    z-index: 1;
    pointer-events: none;
  }
  .translucent-backdrop img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: right bottom;
    opacity: 0.55;
    filter: blur(0.4px) saturate(0.85);
  }
  @media (max-width: 768px) {
    .translucent-backdrop { width: 85vw; }
    .translucent-backdrop img { opacity: 0.3; }
  }
</style>
