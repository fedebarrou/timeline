---
/**
 * Floating left-margin sidebar on `/personajes/[id]`.
 *
 * Per user feedback the sidebar is now:
 *   - Position-fixed at the left viewport edge so the article keeps its
 *     ORIGINAL centred max-w-4xl width (the grid layout it had before
 *     was shaving the right column).
 *   - Scoped to the current era's characters only — browsing patriarcal
 *     while reading about Abraham, evangelio while reading about Jesús,
 *     etc. — instead of dumping all 160+ characters in one list.
 *   - Headed with an era kicker + era display name so the reader knows
 *     where they are at a glance.
 *   - Equipped with a search box that filters the list by name on input.
 *   - Without prev/next arrows (the search + click are enough; keyboard
 *     ←/→ was a nice-to-have but the user removed it).
 *
 * Visibility: only ≥ 1280px viewport (xl). On narrower screens the
 * article keeps the full viewport for itself and the user navigates via
 * the back-link to /personajes. The breakpoint is the smallest one where
 * a ~200px sidebar fits in the LEFT margin of the centred max-w-4xl
 * article without overlapping it ((1280 − 896) / 2 ≈ 192px of margin).
 */
import type { CollectionEntry } from 'astro:content';

interface Props {
  currentId: string;
  /** Characters in the SAME era as the current one, pre-ordered (by
   *  group → birthYear). The page passes the filtered+sorted list so
   *  this component stays a dumb renderer. */
  ordered: CollectionEntry<'characters'>[];
  eraName: string;
}
const { currentId, ordered, eraName } = Astro.props;
type Char = CollectionEntry<'characters'>;
---
<aside class="char-nav-sidebar" data-char-nav-sidebar aria-label={`Personajes de la era ${eraName}`}>
  <div class="char-nav-header">
    <span class="char-nav-era-kicker">Era</span>
    <h2 class="char-nav-era-name">{eraName}</h2>
    <input
      type="search"
      class="char-nav-search"
      data-char-nav-search
      placeholder="Buscar personaje..."
      aria-label={`Buscar personaje en ${eraName}`}
      autocomplete="off"
      spellcheck="false"
    />
  </div>
  <ol class="char-nav-list" data-char-nav-list>
    {ordered.map((c: Char) => {
      const isCurrent = c.data.id === currentId;
      return (
        <li
          class:list={['char-nav-item', isCurrent && 'is-current']}
          data-name={c.data.name.toLowerCase()}
        >
          <a href={`/personajes/${c.data.id}`} class="char-nav-link">
            <span class="char-nav-name">{c.data.name}</span>
            {c.data.birthYear !== undefined && (
              <span class="char-nav-year">~ {c.data.birthYear}</span>
            )}
          </a>
        </li>
      );
    })}
  </ol>
  <p class="char-nav-empty" data-char-nav-empty hidden>Sin resultados.</p>
</aside>

<script>
  /* Live search — filters list items by name match. Empty query restores
     every item. We toggle a `display: none` rather than removing nodes so
     the "scroll current into view" behaviour (and any re-rerender) keeps
     working without rebuilding the list. */
  const search = document.querySelector<HTMLInputElement>('[data-char-nav-search]');
  const list = document.querySelector<HTMLElement>('[data-char-nav-list]');
  const emptyEl = document.querySelector<HTMLElement>('[data-char-nav-empty]');
  if (search && list) {
    search.addEventListener('input', () => {
      const q = search.value.trim().toLowerCase();
      let visible = 0;
      list.querySelectorAll<HTMLElement>('.char-nav-item').forEach((li) => {
        const name = li.dataset.name ?? '';
        const show = !q || name.includes(q);
        li.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (emptyEl) emptyEl.hidden = visible > 0 || q.length === 0;
    });
    // Esc clears the search.
    search.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') { search.value = ''; search.dispatchEvent(new Event('input')); search.blur(); }
    });
  }

  /* On mount, scroll the highlighted item into view so the reader lands
     looking at "where they are" in the era. `auto` (no smooth) because
     animating across a long list reads as a UI tic. */
  (function scrollCurrentIntoView() {
    const current = list?.querySelector<HTMLElement>('.char-nav-item.is-current');
    if (!current || !list) return;
    requestAnimationFrame(() => {
      const lr = list.getBoundingClientRect();
      const cr = current.getBoundingClientRect();
      list.scrollTop += cr.top - lr.top - lr.height / 2 + cr.height / 2;
    });
  })();
</script>

<style>
  .char-nav-sidebar {
    /* Hidden by default — only wide viewports get the floating sidebar.
       Below 1280px we'd overlap the centred article. */
    display: none;
  }
  @media (min-width: 1280px) {
    .char-nav-sidebar {
      display: flex;
      flex-direction: column;
      gap: 0.7rem;
      position: fixed;
      top: calc(var(--site-nav-h, 3.5rem) + 1.5rem);
      left: 0.5rem;
      width: 190px;
      max-height: calc(100vh - var(--site-nav-h, 3.5rem) - 3rem);
      padding: 0.4rem 0.6rem;
      z-index: 5;
      font-family: var(--era-body, 'EB Garamond', Georgia, serif);
    }
  }
  @media (min-width: 1440px) {
    .char-nav-sidebar {
      left: 1rem;
      width: 220px;
    }
  }

  .char-nav-header {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding-bottom: 0.55rem;
    border-bottom: 1px solid color-mix(in srgb, var(--era-primary) 18%, transparent);
  }
  .char-nav-era-kicker {
    font-size: 9px;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    opacity: 0.55;
    color: var(--era-text);
  }
  .char-nav-era-name {
    margin: 0;
    font-family: var(--era-display, 'Cinzel', serif);
    font-size: 15px;
    line-height: 1.15;
    letter-spacing: 0.04em;
    color: var(--era-primary);
  }
  .char-nav-search {
    width: 100%;
    padding: 0.35rem 0.55rem;
    border: 1px solid var(--era-border);
    border-radius: 6px;
    background: color-mix(in srgb, var(--era-surface) 70%, transparent);
    color: var(--era-text);
    font-family: inherit;
    font-size: 11.5px;
    line-height: 1.3;
    outline: none;
    transition: border-color 160ms ease, background 160ms ease;
  }
  .char-nav-search::placeholder { opacity: 0.45; }
  .char-nav-search:focus {
    border-color: var(--era-accent);
    background: color-mix(in srgb, var(--era-surface) 90%, transparent);
  }

  .char-nav-list {
    list-style: none;
    margin: 0;
    padding: 0.25rem 0;
    overflow-y: auto;
    flex: 1 1 auto;
    scrollbar-width: thin;
  }
  .char-nav-item { margin: 0; padding: 0; }
  .char-nav-link {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.45rem;
    padding: 0.32rem 0.45rem;
    color: var(--era-text);
    text-decoration: none;
    border-left: 3px solid transparent;
    transition: background 160ms ease, border-color 160ms ease, color 160ms ease;
  }
  .char-nav-link:hover {
    background: color-mix(in srgb, var(--era-primary) 8%, transparent);
    border-left-color: color-mix(in srgb, var(--era-primary) 50%, transparent);
    color: var(--era-primary);
  }
  .char-nav-item.is-current .char-nav-link {
    background: color-mix(in srgb, var(--era-accent) 14%, transparent);
    border-left-color: var(--era-accent);
    color: var(--era-primary);
    font-weight: 600;
  }
  .char-nav-name {
    font-size: 12.5px;
    line-height: 1.25;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .char-nav-year {
    flex: 0 0 auto;
    font-size: 9.5px;
    opacity: 0.5;
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }
  .char-nav-empty {
    margin: 0.4rem 0 0;
    padding: 0 0.45rem;
    font-size: 11px;
    opacity: 0.55;
    font-style: italic;
  }
</style>
