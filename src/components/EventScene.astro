---
import type { CollectionEntry } from 'astro:content';
import { render, getEntry, getCollection } from 'astro:content';
import { existsSync } from 'node:fs';
import { join } from 'node:path';
import ComparativeBlock from './ComparativeBlock.astro';
import SourceBadge from './SourceBadge.astro';
import DeepDive from './DeepDive.astro';
import MediaHero from './MediaHero.astro';
import MediaGallery from './MediaGallery.astro';
import VideoEmbed from './VideoEmbed.astro';
import NarratorButton from './NarratorButton.astro';
import PortraitPlaceholder from './PortraitPlaceholder.astro';
import MiniHistorySection from './MiniHistorySection.astro';
import { VIRTUAL_SPEAKERS, type DialogCue } from '../lib/dialogTypes';
import PRIMORDIAL_DIALOGS from '../lib/dialogs/primordial';
import PATRIARCAL_DIALOGS from '../lib/dialogs/patriarcal';
import EXODO_DIALOGS from '../lib/dialogs/exodo';
import REINOS_DIALOGS from '../lib/dialogs/reinos-y-exilio';
import EVANGELIO_DIALOGS from '../lib/dialogs/evangelio';
import REVELACION_DIALOGS from '../lib/dialogs/revelacion';

interface Props { event: CollectionEntry<'events'>; }
const { event } = Astro.props;
const data = event.data;
const { Content } = await render(event);
const primaryLocation = data.locations[0];

// Religiones donde aparece cada personaje — mismo helper que CharacterInfoPanel.
type Tradition = 'tora' | 'biblia' | 'coran';
function hasRealMentions(arr: any[] | undefined): boolean {
  if (!arr || arr.length === 0) return false;
  return arr.some((m) => {
    const marker = m?.book ?? m?.sura ?? m?.reference ?? '';
    return marker !== '—' && marker !== '';
  });
}
function religionsFor(cd: any): Tradition[] {
  const m = cd?.mentions ?? {};
  const out: Tradition[] = [];
  if (hasRealMentions(m.tora))   out.push('tora');
  if (hasRealMentions(m.biblia)) out.push('biblia');
  if (hasRealMentions(m.coran))  out.push('coran');
  return out;
}

// Build-time detection: is there a pre-generated narration MP3 for this event?
// File path resolved relative to project root (this .astro file lives in
// src/components, public/ is two levels up).
// Resolve via process.cwd() — `import.meta.url` is unreliable here because
// Astro bundles components into `dist/.prerender/chunks/*.mjs` during build,
// so the relative `../../public` would land at `dist/public` (missing) and
// every event silently fell back to Web Speech instead of using the MP3.
const audioRelPath = `/audio/${data.id}.mp3`;
const audioAbsPath = join(process.cwd(), 'public', 'audio', `${data.id}.mp3`);
const audioSrc: string | null = existsSync(audioAbsPath) ? audioRelPath : null;

// Build narration text from body MDX + comparative.
// IMPORTANT: strip everything that reads badly out loud — parentheses, brackets,
// scripture citations like "Gn 1:26-31" or "Sura 2:30".
function cleanForTTS(s: string): string {
  return s
    // remove markdown control chars
    .replace(/[#*_`>]/g, '')
    // markdown links: keep label only
    .replace(/\[([^\]]+)\]\([^)]+\)/g, '$1')
    // remove parenthetical content "(...)" — can be nested, run twice
    .replace(/\([^()]*\)/g, '')
    .replace(/\([^()]*\)/g, '')
    // remove square-bracket content "[...]"
    .replace(/\[[^\]]*\]/g, '')
    // remove bare scripture citations like "Génesis 1:26-31", "Gn 1:26", "Sura 2:30-37"
    .replace(/\b(?:Gn|Génesis|Ex|Éxodo|Lv|Levítico|Nm|Números|Dt|Deuteronomio|Mt|Mateo|Mc|Marcos|Lc|Lucas|Jn|Juan|Hch|Hechos|Ro|Romanos|Heb|Hebreos|Sura)\s*\d+:\d+(?:-\d+)?\b/g, '')
    // collapse leftover dashes / commas / colons from removed citations
    .replace(/[ \t]+([,.;:])/g, '$1')
    .replace(/\s{2,}/g, ' ')
    .replace(/[ \t]*([,.;:])[ \t]*\1+/g, '$1')
    .trim();
}

const bodyText = event.body ?? '';
const narrationParts = [
  data.title,
  data.subtitle ?? '',
  cleanForTTS(bodyText),
  cleanForTTS(data.comparative.unified ?? ''),
  data.comparative.divergent && data.comparative.tora ? `Según la Torá: ${cleanForTTS(data.comparative.tora.summary)}` : '',
  data.comparative.divergent && data.comparative.biblia ? `Según la Biblia: ${cleanForTTS(data.comparative.biblia.summary)}` : '',
  data.comparative.divergent && data.comparative.coran ? `Según el Corán: ${cleanForTTS(data.comparative.coran.summary)}` : '',
];
const narrationText = narrationParts.filter(Boolean).join('. ').replace(/\s+/g, ' ').trim();

const charactersInEvent = await Promise.all(
  (data.characters ?? []).map(async (c: { id: string; role: string; lore?: string }) => {
    const ch = await getEntry('characters', c.id);
    if (!ch) return null;
    return {
      id: c.id,
      role: c.role,
      lore: c.lore,
      name: ch.data.name,
      portrait: ch.data.portrait,
      avatar: ch.data.avatar,
      meaning: ch.data.alternateNames?.meaning,
      birthYear: ch.data.birthYear,
      deathYear: ch.data.deathYear,
      significance: ch.data.significance,
      trivia: ch.data.trivia,
      religions: religionsFor(ch.data),
    };
  })
).then((arr) => arr.filter(Boolean) as Array<NonNullable<typeof arr[0]>>);

// Diálogos del evento (móvil) — agrupados por era en módulos separados.
const ERA_DIALOGS: Record<string, Record<string, DialogCue[]>> = {
  primordial: PRIMORDIAL_DIALOGS,
  patriarcal: PATRIARCAL_DIALOGS,
  exodo: EXODO_DIALOGS,
  'reinos-y-exilio': REINOS_DIALOGS,
  evangelio: EVANGELIO_DIALOGS,
  revelacion: REVELACION_DIALOGS,
};
const eventDialogs: DialogCue[] = ERA_DIALOGS[data.era]?.[data.id] ?? [];

// Para mostrar el nombre del speaker/addressee necesitamos lookup global —
// un speaker puede ser un personaje que NO aparece en charactersInEvent.
const VIRTUAL_SPEAKER_NAMES: Record<string, string> = {
  yahve: 'Yahvé',
  allah: 'Alá',
  'dios-padre': 'Dios Padre',
  'angel-anonimo': 'Ángel',
  'voz-multitud': 'Voz de la multitud',
};
const speakerNameMap = new Map<string, string>();
if (eventDialogs.length > 0) {
  const allChars = await getCollection('characters');
  for (const ch of allChars) speakerNameMap.set(ch.id, ch.data.name);
  for (const [id, n] of Object.entries(VIRTUAL_SPEAKER_NAMES)) speakerNameMap.set(id, n);
}
---
<section
  id={`event-${data.id}`}
  class="event-scene min-h-[120vh]"
  data-event-scene
  data-event-id={data.id}
  data-event-year={data.biblicalYear}
  data-event-title={data.title}
  data-era={data.era}
  data-svg-x={primaryLocation?.svgPosition[0]}
  data-svg-y={primaryLocation?.svgPosition[1]}
>
  <div class="grid grid-cols-1 md:grid-cols-[40fr_60fr]">
    <div class="narrative px-6 lg:px-10 py-24 flex flex-col justify-center">
      <p class="tracking-[0.4em] opacity-60 mb-3" style="font-size: var(--fs-year)" data-event-year-anchor>— AÑO {data.biblicalYear} —</p>
      <h2 class="font-display mb-2" style="font-size: var(--fs-h2); line-height: 1.1">{data.title}</h2>
      {data.subtitle && <p class="font-display italic opacity-70 mb-4" style={`font-size: var(--fs-h3)`}>{data.subtitle}</p>}

      <div class="narrator-mobile-sticky">
        <NarratorButton eventId={data.id} narrationText={narrationText} audioSrc={audioSrc} />
      </div>

      <MediaHero media={data.media?.hero} />

      {charactersInEvent.length > 0 && (
        <div class="md:hidden mt-4 mb-2">
          <div class="mini-chars flex gap-3 overflow-x-auto pb-2 -mx-6 px-6">
            {charactersInEvent.map((c) => (
              <a
                href={`/personajes/${c.id}?from=${data.era}/event-${data.id}`}
                class="mini-char shrink-0 w-14 flex flex-col items-center gap-1"
                aria-label={`Ver perfil de ${c.name}`}
              >
                {(c.portrait || c.avatar) ? (
                  <img src={c.avatar ?? c.portrait} alt={c.name} loading="lazy" class="w-11 h-11 rounded-full object-cover object-top border border-border" />
                ) : (
                  <div class="w-11 h-11 rounded-full border border-border bg-surface/40 flex items-center justify-center text-sm font-display opacity-70">
                    {c.name.charAt(0)}
                  </div>
                )}
                <span class="text-[10px] leading-tight opacity-75 text-center truncate w-full">{c.name}</span>
              </a>
            ))}
          </div>
        </div>
      )}

      <div class="prose prose-invert max-w-none text-text">
        <Content />
      </div>

      <VideoEmbed video={data.media?.video} />
      <MediaGallery items={data.media?.gallery ?? []} />

      {charactersInEvent.length > 0 && (
        <div class="hidden md:block characters-in-event mt-8">
          <h3 class="text-sm tracking-[0.3em] uppercase opacity-60 mb-4">Personajes en este momento</h3>
          <div class="flex flex-wrap gap-3">
            {charactersInEvent.map((c) => {
              const lifeYears = (c.birthYear != null && c.deathYear != null)
                ? `${c.birthYear}–${c.deathYear} año bíblico`
                : null;
              return (
                <a
                  href={`/personajes/${c.id}?from=${data.era}/event-${data.id}`}
                  class="char-pin group relative inline-flex items-center gap-2 px-3 py-2 rounded-full border border-border bg-surface/40 hover:border-accent transition-colors"
                  aria-label={`Ver perfil de ${c.name}`}
                >
                  <PortraitPlaceholder name={c.name} src={c.portrait ?? undefined} avatar={c.avatar ?? undefined} size="sm" />
                  <span class="text-base font-display">{c.name}</span>
                  <span class="text-[11px] tracking-wider uppercase opacity-60">{c.role.replace(/-/g, ' ')}</span>
                  {c.religions.length > 0 && (
                    <span class="chip-religions inline-flex items-center gap-1 ml-1" aria-label={`Aparece en: ${c.religions.join(', ')}`}>
                      {c.religions.includes('tora') && (
                        <svg class="rel-icon" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true"><path d="M50 8 L88 70 L12 70 Z" /><path d="M50 92 L12 30 L88 30 Z" fill-opacity="0.85" /></svg>
                      )}
                      {c.religions.includes('biblia') && (
                        <svg class="rel-icon" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true"><rect x="42" y="10" width="16" height="80" rx="2" /><rect x="22" y="32" width="56" height="16" rx="2" /></svg>
                      )}
                      {c.religions.includes('coran') && (
                        <svg class="rel-icon" viewBox="0 0 100 100" fill="currentColor" aria-hidden="true"><path d="M50 12 a38 38 0 1 0 32 60 a30 30 0 1 1 0 -44 a38 38 0 0 0 -32 -16 z" /><polygon points="78,28 81,36 89,36 83,41 86,49 78,44 70,49 73,41 67,36 75,36" /></svg>
                      )}
                    </span>
                  )}
                  {c.meaning && <span class="chip-meaning text-[11px] italic opacity-70 ml-1">"{c.meaning}"</span>}

                  <div class="tooltip absolute left-0 top-full z-30 w-80 p-3 rounded-lg border border-border bg-bg shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible pointer-events-none group-hover:pointer-events-auto transition-all duration-200 flex gap-3">
                    {(c.portrait || c.avatar) && (
                      <div class="w-36 flex-shrink-0 self-stretch -ml-3 -my-2 char-tooltip-portrait">
                        <img src={c.portrait ?? c.avatar} alt={c.name} loading="lazy" class="w-full h-full object-cover object-top" />
                      </div>
                    )}
                    <div class="flex-1 min-w-0">
                      <div class="font-display text-base leading-tight">{c.name}</div>
                      {c.meaning && <div class="text-[11px] italic opacity-70 leading-snug">"{c.meaning}"</div>}
                      <div class="text-[10px] tracking-[0.15em] uppercase opacity-60 mt-1">{c.role.replace(/-/g, ' ')}</div>
                      {lifeYears && (
                        <div class="text-[10px] tracking-[0.12em] uppercase opacity-60 mt-0.5">{lifeYears}</div>
                      )}
                      {c.lore ? (
                        <p class="text-[12px] opacity-90 mt-2 leading-snug max-h-28 overflow-y-auto pr-1 whitespace-pre-line">{c.lore}</p>
                      ) : c.significance && (
                        <p class="text-[12px] opacity-85 mt-2 leading-snug max-h-28 overflow-y-auto pr-1">{c.significance.slice(0, 160)}{c.significance.length > 160 ? '…' : ''}</p>
                      )}
                      {c.trivia && c.trivia.length > 0 && (
                        <p class="text-[11px] opacity-70 mt-2 italic leading-snug border-t border-border/40 pt-1.5">{c.trivia[0]}</p>
                      )}
                    </div>
                  </div>
                </a>
              );
            })}
          </div>
        </div>
      )}

      {eventDialogs.length > 0 && (
        <div class="md:hidden mt-6">
          <h3 class="text-sm tracking-[0.3em] uppercase opacity-60 mb-3">Diálogos del evento</h3>
          <ol class="event-dialogs space-y-3">
            {eventDialogs.map((d) => {
              const isVirtual = VIRTUAL_SPEAKERS.has(d.speaker);
              return (
                <li class={`event-dialog ${isVirtual ? 'event-dialog-virtual' : 'event-dialog-mortal'}`}>
                  <div class="ed-speaker">
                    <span class="ed-name">{speakerNameMap.get(d.speaker) ?? d.speaker}</span>
                    {d.addressee && (
                      <span class="ed-arrow">→ <span class="ed-addressee">{speakerNameMap.get(d.addressee) ?? d.addressee}</span></span>
                    )}
                  </div>
                  <blockquote class="ed-text">{d.text}</blockquote>
                </li>
              );
            })}
          </ol>
        </div>
      )}

      {/* Mobile: bloques colapsables */}
      <div class="md:hidden mt-6 space-y-2">
        {data.comparative.divergent && (
          <details class="mobile-accordion">
            <summary>Torá / Biblia / Corán</summary>
            <div class="mobile-accordion-body">
              <ComparativeBlock comparative={data.comparative} />
            </div>
          </details>
        )}
        {data.sources.length > 0 && (
          <details class="mobile-accordion">
            <summary>Fuentes consultadas</summary>
            <div class="mobile-accordion-body">
              <ul class="space-y-2">
                {data.sources.map((s) => <li><SourceBadge source={s} /></li>)}
              </ul>
            </div>
          </details>
        )}
        <details class="mobile-accordion">
          <summary>Mini-historia</summary>
          <div class="mobile-accordion-body">
            <MiniHistorySection
              eventId={data.id}
              eventTitle={data.title}
              eventSubtitle={data.subtitle}
            />
          </div>
        </details>
        {data.deepDive && (
          <details class="mobile-accordion">
            <summary>Profundizar</summary>
            <div class="mobile-accordion-body">
              <DeepDive deepDive={data.deepDive} />
            </div>
          </details>
        )}
      </div>

      {/* Desktop: bloques siempre expandidos */}
      <div class="hidden md:block">
        {data.comparative.divergent && (
          <ComparativeBlock comparative={data.comparative} />
        )}

        {data.sources.length > 0 && (
          <div class="mt-8">
            <h3 class="text-sm tracking-[0.3em] uppercase opacity-60 mb-3">Fuentes consultadas</h3>
            <ul class="space-y-2">
              {data.sources.map((s) => <li><SourceBadge source={s} /></li>)}
            </ul>
          </div>
        )}

        <MiniHistorySection
          eventId={data.id}
          eventTitle={data.title}
          eventSubtitle={data.subtitle}
        />

        <DeepDive deepDive={data.deepDive} />
      </div>
    </div>

    <div class="map-spacer hidden md:block"></div>
  </div>
</section>

<style>
  /* Character tooltip portrait — true nebula/smoke edges.
     Technique: SVG mask built from a black ellipse passed through
     feTurbulence (fractal noise) + feDisplacementMap (warps the edge
     using that noise) + feGaussianBlur (softens the result). The
     displacement creates organic, asymmetric wisps; the blur gives a
     smoky falloff. preserveAspectRatio='none' lets the cloud stretch
     to whatever height the card ends up being. */
  .char-tooltip-portrait {
    --cloud-mask: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 140' preserveAspectRatio='none'><defs><filter id='c' x='-20' y='-20' width='140' height='180' filterUnits='userSpaceOnUse'><feTurbulence type='fractalNoise' baseFrequency='0.038' numOctaves='3' seed='8' result='n'/><feDisplacementMap in='SourceGraphic' in2='n' scale='22'/><feGaussianBlur stdDeviation='4.5'/></filter></defs><ellipse cx='50' cy='70' rx='36' ry='58' fill='black' filter='url(%23c)'/></svg>");
    -webkit-mask-image: var(--cloud-mask);
            mask-image: var(--cloud-mask);
    -webkit-mask-size: 100% 100%;
            mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
    -webkit-mask-position: center;
            mask-position: center;
    /* Era-tinted glow behind the cloud — feels like the figure radiates
       the era's accent colour into the surrounding card surface. */
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--era-accent, #d4a574) 40%, transparent));
  }
  .char-tooltip-portrait img {
    /* Subtle contrast lift so the figure stays readable through the
       softer edges of the mask. */
    filter: contrast(1.06) saturate(1.05);
  }
  .mobile-accordion {
    border: 1px solid var(--era-border);
    border-radius: 8px;
    background: color-mix(in srgb, var(--era-surface) 50%, transparent);
    overflow: hidden;
  }
  .mobile-accordion > summary {
    list-style: none;
    cursor: pointer;
    padding: 0.9rem 1rem;
    font-family: var(--era-display);
    font-size: 0.95rem;
    letter-spacing: 0.04em;
    display: flex;
    align-items: center;
    justify-content: space-between;
    min-height: 44px;
  }
  .mobile-accordion > summary::-webkit-details-marker { display: none; }
  .mobile-accordion > summary::after {
    content: '▸';
    color: var(--era-primary);
    transition: transform 200ms ease;
    font-size: 0.8rem;
    margin-left: 0.5rem;
  }
  .mobile-accordion[open] > summary::after {
    transform: rotate(90deg);
  }
  .mobile-accordion-body {
    padding: 0 1rem 1rem;
  }
  .mini-chars { scrollbar-width: none; }
  .mini-chars::-webkit-scrollbar { display: none; }
  .mini-char { text-decoration: none; color: inherit; transition: opacity 200ms ease; }
  .mini-char:active { opacity: 0.6; }
  .mini-char img { transition: border-color 200ms ease; }
  .mini-char:hover img { border-color: var(--era-accent); }

  .narrator-mobile-sticky { display: flex; justify-content: flex-end; }
  @media (max-width: 767px) {
    .narrator-mobile-sticky {
      position: sticky;
      bottom: 0.75rem;
      z-index: 30;
      margin-top: 0.5rem;
    }
  }

  /* Chip extras: religion icons + significado del nombre.
     Icons use the same SVG as CharacterInfoPanel watermarks; sized small
     so the chip stays compact and readable. */
  .chip-religions .rel-icon {
    width: 14px;
    height: 14px;
    color: var(--era-primary);
    opacity: 0.85;
  }
  .chip-meaning {
    max-width: 16ch;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* Diálogos del evento (móvil) — bloque conversación tipo pergamino.
     Hablantes virtuales (deidades) reciben acento dorado e itálica;
     mortales se quedan con el primary de la era. */
  .event-dialogs { list-style: none; padding: 0; margin: 0; }
  .event-dialog {
    padding: 0.75rem 0.9rem;
    border-left: 3px solid var(--era-primary);
    background: color-mix(in srgb, var(--era-surface) 35%, transparent);
    border-radius: 0 6px 6px 0;
  }
  .event-dialog-virtual {
    border-left-color: var(--era-accent);
    background: color-mix(in srgb, var(--era-accent) 12%, var(--era-surface) 35%);
  }
  .ed-speaker {
    font-size: 0.7rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.75;
    margin-bottom: 0.35rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
  }
  .ed-name { font-family: var(--era-display); font-weight: 600; }
  .event-dialog-virtual .ed-name { color: var(--era-accent); font-style: italic; }
  .ed-arrow { opacity: 0.55; }
  .ed-text {
    font-family: var(--era-body, 'EB Garamond', Georgia, serif);
    font-size: 0.95rem;
    line-height: 1.45;
    margin: 0;
    font-style: italic;
  }
  .event-dialog-virtual .ed-text { font-weight: 500; }
</style>
