---
interface Props {
  media?: {
    src: string;
    credit: string;
    license: string;
    source?: string;
    caption?: string;
  };
}
const { media } = Astro.props;
---
{media && (
  <figure class="media-hero mb-8" data-media-hero>
    {/* Inline-block: container shrinks to the natural size of the image,
        so there is NEVER a letterbox/blur strip on the sides or bottom.
        Capped at max-h-[55vh] so very tall vertical paintings don't
        dominate the scene. */}
    <div class="inline-block w-auto max-w-full rounded-lg overflow-hidden bg-surface border border-border">
      <img
        src={media.src}
        alt={media.caption ?? ''}
        loading="lazy"
        class="block w-auto h-auto max-w-full max-h-[55vh] ken-burns"
        data-img
      />
    </div>
    <div class="placeholder hidden mt-2 text-center px-6 py-12 rounded-lg bg-surface border border-border" data-placeholder>
      <p class="font-display text-2xl italic opacity-70">{media.caption ?? ''}</p>
      <p class="text-sm opacity-50 mt-3">{media.credit}</p>
    </div>
    <figcaption class="mt-2 text-sm opacity-60 flex flex-wrap gap-3">
      <span>{media.credit}</span>
      <span class="opacity-60">·</span>
      <span class="opacity-60">{media.license}</span>
      {media.source && <><span class="opacity-60">·</span><span>{media.source}</span></>}
    </figcaption>
  </figure>
)}

<script>
  document.querySelectorAll<HTMLElement>('[data-media-hero]').forEach((fig) => {
    const img = fig.querySelector<HTMLImageElement>('[data-img]');
    const placeholder = fig.querySelector<HTMLElement>('[data-placeholder]');
    if (!img || !placeholder) return;
    img.addEventListener('error', () => {
      img.style.display = 'none';
      placeholder.classList.remove('hidden');
    });
  });
</script>

<style>
  /* Subtle ken-burns — no positional drift since the image is object-contain
     (so it's already letterboxed). A gentle scale only. */
  .ken-burns {
    animation: ken-burns 24s ease-in-out infinite alternate;
    transform-origin: center;
  }
  @keyframes ken-burns {
    from { transform: scale(1); }
    to   { transform: scale(1.04); }
  }
  @media (prefers-reduced-motion: reduce) {
    .ken-burns { animation: none; }
  }
</style>
