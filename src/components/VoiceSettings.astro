---
/**
 * Voice settings panel.
 *
 * Behaviour:
 *  - If the page has a pre-generated neural MP3 narration for the current
 *    event (data-audio-src on the narrator), we show a single message:
 *    "Voz neural pre-generada — Microsoft Edge". No selector, no sliders
 *    visible because they don't apply.
 *  - Otherwise we silently fall back to the browser's best Spanish voice
 *    (auto-selected by tts.ts → `getPreferredVoice()`). No dropdown shown
 *    because the listed voices are platform-dependent and most are unreliable.
 *  - A single slider stays available: playback speed. That's the only knob
 *    that matters for both code paths.
 */
---
<div class="voice-settings relative inline-block" data-voice-settings>
  <button
    type="button"
    class="px-3 py-1.5 rounded-full border border-border bg-bg/70 backdrop-blur text-[11px] md:text-xs tracking-wider uppercase hover:border-accent inline-flex items-center gap-2 whitespace-nowrap"
    data-voice-toggle
    aria-label="Configurar voz"
    title="Configurar voz"
  >
    <span aria-hidden="true">&#9881;</span>
    <span class="hidden md:inline">Voz</span>
  </button>
  <div class="voice-panel hidden absolute top-full mt-2 right-0 w-72 rounded-lg border border-border bg-bg/95 backdrop-blur p-4 shadow-lg z-50" data-voice-panel>
    <h4 class="text-xs tracking-wider uppercase opacity-70 mb-3">Narración</h4>

    {/* Status — neural pre-generated vs browser fallback */}
    <div
      class="text-[11px] leading-snug mb-4 p-3 rounded border border-accent/40 bg-accent/10 text-text/90"
      data-status
    >
      <span data-status-text>Detectando…</span>
    </div>

    {/* Single slider: playback speed (applies to both audio & speechSynthesis) */}
    <label class="block text-[11px] uppercase tracking-wider opacity-70">
      Velocidad <span data-rate-value class="float-right opacity-80">0.95×</span>
      <input
        type="range"
        min="0.6" max="1.4" step="0.05"
        class="w-full mt-1 accent-accent"
        data-rate-slider
      />
    </label>
  </div>
</div>

<script>
  import { getRate, setRate } from '../lib/tts';

  const root = document.querySelector<HTMLElement>('[data-voice-settings]');
  if (root) {
    const toggle = root.querySelector<HTMLButtonElement>('[data-voice-toggle]')!;
    const panel = root.querySelector<HTMLElement>('[data-voice-panel]')!;
    const statusText = root.querySelector<HTMLElement>('[data-status-text]')!;
    const rateSlider = root.querySelector<HTMLInputElement>('[data-rate-slider]')!;
    const rateValue = root.querySelector<HTMLElement>('[data-rate-value]')!;

    function refreshStatus() {
      const hasNeural = !!document.querySelector('[data-narrator] audio[src]');
      statusText.innerHTML = hasNeural
        ? '<strong class="text-accent">Voz neural pre-generada</strong><br/>Microsoft Edge — calidad humana.'
        : '<strong>Voz del navegador</strong><br/>Auto-seleccionada (la mejor disponible para español).';
    }

    function syncSlider() {
      const r = getRate();
      rateSlider.value = String(r);
      rateValue.textContent = `${r.toFixed(2)}×`;
    }

    refreshStatus();
    syncSlider();

    rateSlider.addEventListener('input', () => {
      const v = parseFloat(rateSlider.value);
      setRate(v);
      rateValue.textContent = `${v.toFixed(2)}×`;
    });

    toggle.addEventListener('click', (e) => {
      e.stopPropagation();
      refreshStatus();
      panel.classList.toggle('hidden');
    });
    document.addEventListener('click', (e) => {
      if (!root.contains(e.target as Node)) panel.classList.add('hidden');
    });
  }
</script>
