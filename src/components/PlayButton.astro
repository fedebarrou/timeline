<button
  type="button"
  class="play-mode-btn inline-flex items-center gap-2 px-3 py-1.5 rounded-full border border-primary bg-bg/70 backdrop-blur text-primary hover:bg-primary hover:text-bg transition-colors text-[11px] md:text-xs tracking-wider uppercase shadow-sm whitespace-nowrap"
  data-play-mode
  aria-label="Reproducir era"
  title="Reproducir era"
>
  <span class="play-icon" data-state="paused">▶</span>
  <span class="play-label hidden md:inline">Reproducir era</span>
  <span class="play-progress text-[10px] opacity-70 hidden" data-play-progress></span>
</button>

<script>
  import { startPlay, stopPlay, isPlaying } from '../lib/playMode';
  const btn = document.querySelector<HTMLButtonElement>('[data-play-mode]');
  if (btn) {
    const icon = btn.querySelector<HTMLElement>('.play-icon')!;
    const label = btn.querySelector<HTMLElement>('.play-label')!;
    const progress = btn.querySelector<HTMLElement>('[data-play-progress]')!;

    function setPlayingUI() {
      progress.classList.remove('hidden');
      icon.textContent = '■';
      icon.dataset.state = 'playing';
      label.textContent = 'Detener';
    }
    function resetUI() {
      icon.textContent = '▶';
      icon.dataset.state = 'paused';
      label.textContent = 'Reproducir era';
      progress.classList.add('hidden');
    }
    function progressUpdater(i: number, total: number) {
      progress.textContent = `${i}/${total}`;
    }

    btn.addEventListener('click', () => {
      if (isPlaying()) {
        stopPlay();
        return;
      }
      startPlay(progressUpdater);
    });

    // Sync to the global play singleton. Both the click handler above and
    // any external trigger (FullscreenControls, restart pill, ?play=1
    // auto-start) flow through playMode.ts, which now broadcasts
    // `timeline:play-state-changed`. Listening here means we never end up
    // with the button label out of sync with the actual engine state.
    if (isPlaying()) setPlayingUI();
    window.addEventListener('timeline:play-state-changed', (e) => {
      if ((e as CustomEvent).detail?.playing) setPlayingUI();
      else resetUI();
    });
  }
</script>
