---
/**
 * Theme-only component: emits `[data-era="<id>"] { --era-*: ... }` CSS
 * vars. Rendered N times by BaseLayout (one per era) so every era's
 * palette is pre-loaded.
 *
 * NOTE: the per-page ambient mount lives in `pages/era/[id].astro`,
 * NOT here, because this component is rendered multiple times and we
 * only want to mount ambient for the ONE active era.
 */
import type { Era } from '../lib/eras';
import { eraToCssVars } from '../lib/eras';

interface Props { era: Era; }
const { era } = Astro.props;
const vars = eraToCssVars(era.data);
const eraId = era.data.id;
---
<style set:html={`[data-era="${eraId}"] {\n  ${vars}\n}`}></style>
