---
---
<button
  type="button"
  class="event-nav-arrow event-nav-prev fixed left-2 md:left-4 z-40 w-10 h-10 md:w-12 md:h-12 rounded-full border-2 border-accent bg-surface text-accent hover:bg-accent hover:text-bg transition-colors flex items-center justify-center shadow-xl"
  data-event-nav="prev"
  aria-label="Evento anterior"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="15 18 9 12 15 6"></polyline>
  </svg>
</button>

<button
  type="button"
  class="event-nav-arrow event-nav-next fixed right-2 md:right-4 z-40 w-10 h-10 md:w-12 md:h-12 rounded-full border-2 border-accent bg-surface text-accent hover:bg-accent hover:text-bg transition-colors flex items-center justify-center shadow-xl"
  data-event-nav="next"
  aria-label="Evento siguiente"
>
  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round">
    <polyline points="9 18 15 12 9 6"></polyline>
  </svg>
</button>

<style>
  /* Desktop: vertically centered in the viewport (default Tailwind top-1/2 +
     translate doesn't work as part of utility classes here, set explicitly). */
  .event-nav-arrow {
    top: 50%;
    transform: translateY(-50%);
  }
  /* Mobile: the map is a sticky strip at the top (35vh under the nav stack).
     Center the arrows vertically INSIDE that strip so they sit on the map
     itself, not over the narrative column. */
  @media (max-width: 767px) {
    .event-nav-arrow {
      top: calc(var(--sticky-header-h, 7rem) + 17.5vh);
    }
  }
</style>

<script>
  import { isPlaying, jumpToEventId } from '../lib/playMode';
  import { scrollToElement } from '../lib/scrollOffset';

  function getScenes(): HTMLElement[] {
    return Array.from(document.querySelectorAll<HTMLElement>('[data-event-scene]'));
  }

  // In fullscreen, viewport-based detection is unreliable because the
  // .scenes are display:none and scroll position is frozen. Track the
  // active event id via `timeline:scene-changed` events instead.
  let activeEventId: string | null = null;
  window.addEventListener('timeline:scene-changed', (e: Event) => {
    const id = (e as CustomEvent<{ eventId?: string }>).detail?.eventId;
    if (id) activeEventId = id;
  });

  function findActiveIndex(scenes: HTMLElement[]): number {
    if (document.body.classList.contains('map-fullscreen') && activeEventId) {
      const idx = scenes.findIndex((s) => s.dataset.eventId === activeEventId);
      if (idx !== -1) return idx;
    }
    const viewportCenter = window.scrollY + window.innerHeight / 2;
    let best = 0;
    let bestDist = Infinity;
    scenes.forEach((s, i) => {
      const top = s.getBoundingClientRect().top + window.scrollY;
      const center = top + s.offsetHeight / 2;
      const dist = Math.abs(center - viewportCenter);
      if (dist < bestDist) { bestDist = dist; best = i; }
    });
    return best;
  }

  function navigate(direction: 'prev' | 'next') {
    const scenes = getScenes();
    if (scenes.length === 0) return;
    const idx = findActiveIndex(scenes);
    const target = direction === 'prev' ? idx - 1 : idx + 1;
    if (target < 0 || target >= scenes.length) return;
    const targetScene = scenes[target];
    const targetId = targetScene.dataset.eventId;

    if (isPlaying() && targetId) {
      // Inside play mode: re-route via playMode so narration jumps too
      const playBtn = document.querySelector<HTMLElement>('[data-play-mode]');
      const progress = playBtn?.querySelector<HTMLElement>('[data-play-progress]');
      jumpToEventId(targetId, (i, total) => {
        if (progress) progress.textContent = `${i}/${total}`;
      });
    } else if (document.body.classList.contains('map-fullscreen') && targetId) {
      // In fullscreen, the `.scenes` are display:none and ScrollTriggers
      // are paused — scrolling does nothing. Dispatch an explicit
      // request-activate so the map marker / camera / choreography move.
      window.dispatchEvent(new CustomEvent('timeline:scene-changed', { detail: { eventId: targetId } }));
      window.dispatchEvent(new CustomEvent('timeline:request-activate', { detail: { eventId: targetId } }));
    } else {
      scrollToElement(targetScene);
    }
  }

  const prevBtn = document.querySelector<HTMLButtonElement>('[data-event-nav="prev"]');
  const nextBtn = document.querySelector<HTMLButtonElement>('[data-event-nav="next"]');
  if (prevBtn) prevBtn.addEventListener('click', () => navigate('prev'));
  if (nextBtn) nextBtn.addEventListener('click', () => navigate('next'));

  // Hide prev on first scene, hide next on last scene
  function updateVisibility() {
    const scenes = getScenes();
    if (scenes.length === 0) {
      prevBtn?.classList.add('opacity-0', 'pointer-events-none');
      nextBtn?.classList.add('opacity-0', 'pointer-events-none');
      return;
    }
    const idx = findActiveIndex(scenes);
    if (prevBtn) {
      const disabled = idx <= 0;
      prevBtn.classList.toggle('opacity-0', disabled);
      prevBtn.classList.toggle('pointer-events-none', disabled);
    }
    if (nextBtn) {
      const disabled = idx >= scenes.length - 1;
      nextBtn.classList.toggle('opacity-0', disabled);
      nextBtn.classList.toggle('pointer-events-none', disabled);
    }
  }

  updateVisibility();
  window.addEventListener('scroll', updateVisibility, { passive: true });
  document.addEventListener('DOMContentLoaded', updateVisibility);

  // Keyboard shortcuts: left/right arrows
  document.addEventListener('keydown', (e) => {
    if (e.target instanceof HTMLInputElement || e.target instanceof HTMLTextAreaElement) return;
    if (e.key === 'ArrowLeft')  navigate('prev');
    if (e.key === 'ArrowRight') navigate('next');
  });
</script>
