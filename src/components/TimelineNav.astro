---
import type { CollectionEntry } from 'astro:content';

interface Props {
  events: CollectionEntry<'events'>[];
  eras: CollectionEntry<'eras'>[];
  allEras?: CollectionEntry<'eras'>[];
  currentEraId?: string;
}
const { events, eras, allEras = [], currentEraId } = Astro.props;
const minYear = Math.min(...events.map((e) => e.data.biblicalYear));
const maxYear = Math.max(...events.map((e) => e.data.biblicalYear));
const span = (maxYear - minYear) || 1;
function pct(y: number) { return ((y - minYear) / span) * 100; }
const MIN_GAP_PCT = 3;
const sortedEventsByYear = [...events].sort((a, b) => a.data.biblicalYear - b.data.biblicalYear);
const eventPositions = new Map<string, number>();
let lastPct = -Infinity;
for (const e of sortedEventsByYear) {
  let p = pct(e.data.biblicalYear);
  if (p - lastPct < MIN_GAP_PCT) {
    p = lastPct + MIN_GAP_PCT;
  }
  eventPositions.set(e.data.id, Math.min(p, 100));
  lastPct = p;
}

const sortedEras = eras.sort((a, b) => a.data.order - b.data.order);

const sortedAllEras = [...allEras].sort((a, b) => a.data.order - b.data.order);
const currentEraIdx = sortedAllEras.findIndex((e) => e.data.id === currentEraId);
const nextEra = currentEraIdx >= 0 ? sortedAllEras[currentEraIdx + 1] : null;
const prevEra = currentEraIdx > 0 ? sortedAllEras[currentEraIdx - 1] : null;

const nextHref = nextEra ? `/era/${nextEra.data.id}` : '/';
const prevHref = prevEra ? `/era/${prevEra.data.id}` : '/';
---
<div class="timeline-nav fixed top-12 inset-x-0 z-30 px-6 py-3 bg-bg shadow-lg" data-timeline-nav>
  <div class="relative h-8 max-w-7xl mx-auto grid grid-cols-[1fr_auto_1fr] items-center gap-8">

    {/* Left slot: back to all eras */}
    <div class="flex justify-start">
      <a
        href="/"
        class="inline-flex items-center gap-2 text-xs tracking-wider uppercase opacity-60 hover:opacity-100 transition-opacity whitespace-nowrap"
        title="Volver a todas las eras"
      >
        ← Todas las eras
      </a>
    </div>

    {/* Center: timeline bar */}
    <div class="relative h-8 w-full md:w-[500px] lg:w-[700px]">
      <div class="absolute top-1/2 -translate-y-1/2 left-0 right-0 h-px bg-border"></div>

      {sortedEras.map((era) => {
        const eraEvents = events.filter((e) => e.data.era === era.data.id);
        if (eraEvents.length === 0) return null;
        const eraMin = Math.min(...eraEvents.map((e) => e.data.biblicalYear));
        const eraMax = Math.max(...eraEvents.map((e) => e.data.biblicalYear));
        const leftPct = pct(eraMin);
        const widthPct = Math.max(pct(eraMax) - pct(eraMin), 2);
        return (
          <div
            class="absolute top-1/2 -translate-y-1/2 h-1 rounded"
            style={`left: ${leftPct}%; width: ${widthPct}%; background: ${era.data.palette.primary}; opacity: 0.4`}
            title={era.data.name}
          />
        );
      })}

      {events.map((e) => {
        const left = eventPositions.get(e.data.id) ?? pct(e.data.biblicalYear);
        return (
          <a
            href={`#event-${e.data.id}`}
            class="timeline-dot absolute top-1/2 -translate-x-1/2 -translate-y-1/2 group"
            style={`left: ${left}%`}
            data-timeline-marker={e.data.id}
          >
            <div class="w-2.5 h-2.5 rounded-full bg-primary hover:scale-150 transition-transform"></div>
            <div class="absolute top-full mt-2 left-1/2 -translate-x-1/2 whitespace-nowrap text-[10px] opacity-0 group-hover:opacity-100 pointer-events-none transition-opacity bg-bg border border-border rounded px-2 py-1 z-10">
              {e.data.title} <span class="opacity-50">· año {e.data.biblicalYear}</span>
            </div>
          </a>
        );
      })}

      <div class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-3 h-3 rounded-full border-2 border-accent bg-bg transition-all duration-500" data-timeline-active style="left: 0%; box-shadow: 0 0 8px var(--era-accent);"></div>
    </div>

    {/* Right slot: next era or empty */}
    <div class="flex justify-end">
      {nextEra ? (
        <a
          href={nextHref}
          class="inline-flex items-center gap-2 text-xs tracking-wider uppercase opacity-60 hover:opacity-100 transition-opacity whitespace-nowrap"
          title={`Siguiente era: ${nextEra.data.name}`}
        >
          {nextEra.data.name} →
        </a>
      ) : null}
    </div>
  </div>
</div>

<script>
  import { isPlaying, jumpToEventId } from '../lib/playMode';

  function updateActive(eventId: string) {
    const marker = document.querySelector(`[data-timeline-marker="${eventId}"]`);
    const active = document.querySelector<HTMLElement>('[data-timeline-active]');
    if (!marker || !active) return;
    const left = (marker as HTMLElement).style.left;
    active.style.left = left;
  }

  const scenes = document.querySelectorAll<HTMLElement>('[data-event-scene]');
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('data-event-id');
        if (id) updateActive(id);
      }
    }
  }, { rootMargin: '-40% 0px -40% 0px', threshold: 0 });

  scenes.forEach((s) => observer.observe(s));

  // When in play mode, clicking a timeline dot jumps the narration to that event
  document.querySelectorAll<HTMLAnchorElement>('[data-timeline-marker]').forEach((dot) => {
    dot.addEventListener('click', (ev) => {
      const id = dot.getAttribute('data-timeline-marker');
      if (!id) return;
      if (isPlaying()) {
        ev.preventDefault();
        const playBtn = document.querySelector<HTMLElement>('[data-play-mode]');
        const progress = playBtn?.querySelector<HTMLElement>('[data-play-progress]');
        jumpToEventId(id, (i, total) => {
          if (progress) progress.textContent = `${i}/${total}`;
        });
      }
      // Otherwise let the anchor's default scroll behavior happen.
    });
  });
</script>
