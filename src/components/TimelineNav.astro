---
import type { CollectionEntry } from 'astro:content';
import PlayButton from './PlayButton.astro';
import { computeSlots, computeLinePct, type Slot } from '../lib/mobileTimelineWindow';

interface Props {
  events: CollectionEntry<'events'>[];
  eras: CollectionEntry<'eras'>[];
  allEras?: CollectionEntry<'eras'>[];
  currentEraId?: string;
}
const { events, eras, allEras = [], currentEraId } = Astro.props;
const minYear = Math.min(...events.map((e) => e.data.biblicalYear));
const maxYear = Math.max(...events.map((e) => e.data.biblicalYear));
const span = (maxYear - minYear) || 1;
function pct(y: number) { return ((y - minYear) / span) * 100; }
// Distribute event dots so they never overlap. Uses proportional year placement
// with a minimum visual gap, then a backward pass to keep everything inside [0,100].
const MIN_GAP_PCT = 4;
const sortedEventsByYear = [...events].sort((a, b) => a.data.biblicalYear - b.data.biblicalYear);
const N = sortedEventsByYear.length;
const positions: number[] = sortedEventsByYear.map((e) => pct(e.data.biblicalYear));
// Forward: each dot at least MIN_GAP_PCT ahead of previous
for (let i = 1; i < N; i++) {
  if (positions[i] - positions[i - 1] < MIN_GAP_PCT) {
    positions[i] = positions[i - 1] + MIN_GAP_PCT;
  }
}
// If last exceeded 100%, pull everyone back so it fits
if (N > 0 && positions[N - 1] > 100) {
  positions[N - 1] = 100;
  for (let i = N - 2; i >= 0; i--) {
    if (positions[i + 1] - positions[i] < MIN_GAP_PCT) {
      positions[i] = positions[i + 1] - MIN_GAP_PCT;
    }
  }
  // If the first one went below 0, also clamp & redistribute forward once
  if (positions[0] < 0) {
    positions[0] = 0;
    for (let i = 1; i < N; i++) {
      if (positions[i] - positions[i - 1] < MIN_GAP_PCT) {
        positions[i] = positions[i - 1] + MIN_GAP_PCT;
      }
    }
  }
}
const eventPositions = new Map<string, number>();
sortedEventsByYear.forEach((e, i) => eventPositions.set(e.data.id, positions[i]));

const sortedEras = eras.sort((a, b) => a.data.order - b.data.order);

const sortedAllEras = [...allEras].sort((a, b) => a.data.order - b.data.order);
const currentEraIdx = sortedAllEras.findIndex((e) => e.data.id === currentEraId);
const nextEra = currentEraIdx >= 0 ? sortedAllEras[currentEraIdx + 1] : null;
const prevEra = currentEraIdx > 0 ? sortedAllEras[currentEraIdx - 1] : null;

const nextHref = nextEra ? `/era/${nextEra.data.id}` : '/';
const prevHref = prevEra ? `/era/${prevEra.data.id}` : '/';

const slotEvents = sortedEventsByYear.map((e) => ({ id: e.data.id, biblicalYear: e.data.biblicalYear, title: e.data.title }));
const initialSlots: Slot[] = computeSlots(slotEvents, 0);
const [initialLineFrom, initialLineTo] = computeLinePct(initialSlots);
const initialActive = sortedEventsByYear[0];
const totalEvents = sortedEventsByYear.length;
---
<div class="timeline-nav fixed top-12 inset-x-0 z-30 px-3 md:px-5 py-3 bg-bg shadow-lg" data-timeline-nav>
  <div class="flex items-center gap-3 md:gap-4 h-8 w-full">

    {/* LEFT cluster — era anterior, hugs natural width */}
    <div class="shrink-0 flex items-center">
      {prevEra ? (
        <a
          href={prevHref}
          class="inline-flex items-center gap-2 text-xs tracking-wider uppercase opacity-60 hover:opacity-100 transition-opacity whitespace-nowrap"
          aria-label={`Era anterior: ${prevEra.data.name}`}
        >
          <span>←</span>
          <span class="hidden md:inline">{prevEra.data.name}</span>
        </a>
      ) : (
        <span
          class="inline-flex items-center gap-2 text-xs tracking-wider uppercase opacity-25 cursor-not-allowed whitespace-nowrap"
          aria-label="No hay era anterior"
          aria-disabled="true"
        >
          <span>←</span>
          <span class="hidden md:inline">Era anterior</span>
        </span>
      )}
    </div>

    {/* CENTER timeline — flex-1 takes ALL remaining space between left/right clusters.
        `gap-3 md:gap-4` separates the step arrows from the timeline track so the
        first and last dots breathe instead of touching the buttons. */}
    <div class="flex-1 min-w-0 relative h-8 flex items-center gap-3 md:gap-4">
      <button
        type="button"
        class="step-arrow step-arrow-prev shrink-0 w-6 h-6 md:w-7 md:h-7 rounded-full border border-border bg-bg/80 hover:border-accent hover:text-accent text-primary flex items-center justify-center opacity-70 hover:opacity-100 transition-all"
        data-step-arrow="prev"
        aria-label="Punto anterior"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"></polyline></svg>
      </button>
      <div class="timeline-desktop-track relative h-8 flex-1 min-w-0 px-2 md:px-3">
        <div class="absolute top-1/2 -translate-y-1/2 left-0 right-0 h-px bg-border"></div>

        {sortedEras.map((era) => {
          const eraEvents = events.filter((e) => e.data.era === era.data.id);
          if (eraEvents.length === 0) return null;
          const eraMin = Math.min(...eraEvents.map((e) => e.data.biblicalYear));
          const eraMax = Math.max(...eraEvents.map((e) => e.data.biblicalYear));
          const leftPct = pct(eraMin);
          const widthPct = Math.max(pct(eraMax) - pct(eraMin), 2);
          return (
            <div
              class="absolute top-1/2 -translate-y-1/2 h-1 rounded"
              style={`left: ${leftPct}%; width: ${widthPct}%; background: ${era.data.palette.primary}; opacity: 0.4`}
              aria-label={era.data.name}
            />
          );
        })}

        {events.map((e) => {
          const left = eventPositions.get(e.data.id) ?? pct(e.data.biblicalYear);
          return (
            <a
              href={`#event-${e.data.id}`}
              class="timeline-dot absolute top-1/2 -translate-x-1/2 -translate-y-1/2 group"
              style={`left: ${left}%`}
              data-timeline-marker={e.data.id}
              data-marker-title={e.data.title}
              data-marker-year={e.data.biblicalYear}
            >
              <div class="w-1.5 h-1.5 md:w-2.5 md:h-2.5 rounded-full bg-primary hover:scale-150 transition-transform"></div>
              {/* Event TITLE tooltip ABOVE the dot — plain text, no chrome.
                  Hidden by default, shown on hover with high z-index so it
                  always floats above sibling dots. */}
              <div class="timeline-dot-tooltip absolute bottom-full mb-2 left-1/2 -translate-x-1/2 text-[11px] text-primary whitespace-nowrap pointer-events-none opacity-0 group-hover:opacity-100 transition-opacity duration-150 z-[100] font-display tracking-wide" style="text-shadow: 0 0 6px var(--era-bg), 0 0 6px var(--era-bg), 0 0 6px var(--era-bg);">
                {e.data.title}
              </div>
              {/* Year label sitting BELOW the dot. Tiny, low opacity, plain. */}
              <div class="timeline-dot-year absolute top-full mt-1 left-1/2 -translate-x-1/2 text-[9px] opacity-50 whitespace-nowrap pointer-events-none">
                {e.data.biblicalYear}
              </div>
            </a>
          );
        })}

        <div class="absolute top-1/2 -translate-y-1/2 -translate-x-1/2 w-3 h-3 rounded-full border-2 border-accent bg-bg transition-all duration-500" data-timeline-active style="left: 0%; box-shadow: 0 0 8px var(--era-accent);"></div>
      </div>
      <button
  type="button"
  class="tl-mobile-trigger"
  data-tl-mobile-trigger
  aria-haspopup="dialog"
  aria-controls="mobile-timeline-dialog"
  aria-label="Abrir línea de tiempo de la era"
>
  <div class="tl-mobile-track" data-tl-mobile-track>
    <div
      class="tl-mobile-line"
      data-tl-mobile-line
      style={`left: ${initialLineFrom}%; right: ${100 - initialLineTo}%`}
    ></div>
    {initialSlots.map((slot, idx) => (
      slot.kind === 'dot' ? (
        <div
          class:list={["tl-mobile-slot", { "is-active": slot.active }]}
          data-tl-mobile-slot
          data-slot-index={idx}
          data-slot-kind="dot"
          data-event-id={slot.eventId}
        >
          <span class="tl-mobile-dot"></span>
        </div>
      ) : (
        <div
          class="tl-mobile-slot tl-mobile-slot--cap"
          data-tl-mobile-slot
          data-slot-index={idx}
          data-slot-kind="cap"
          data-cap-side={slot.side}
        >
          <span class="tl-mobile-cap">{slot.side === 'start' ? '‹ inicio' : 'fin ›'}</span>
        </div>
      )
    ))}
  </div>
  <div class="tl-mobile-label" data-tl-mobile-label>{initialActive.data.title}</div>
  <div class="tl-mobile-meta" data-tl-mobile-meta>año {initialActive.data.biblicalYear} · 1/{totalEvents}</div>
</button>
      <button
        type="button"
        class="step-arrow step-arrow-next shrink-0 w-6 h-6 md:w-7 md:h-7 rounded-full border border-border bg-bg/80 hover:border-accent hover:text-accent text-primary flex items-center justify-center opacity-70 hover:opacity-100 transition-all"
        data-step-arrow="next"
        aria-label="Punto siguiente"
      >
        <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
      </button>
    </div>

    {/* RIGHT cluster — voice + restart + play, then era siguiente LAST.
        Play sits before the next-era arrow so the user reproducer la era
        BEFORE saltar a la siguiente, no al revés. */}
    <div class="shrink-0 flex items-center gap-2 md:gap-3">
      <button
        type="button"
        class="restart-btn inline-flex items-center justify-center w-7 h-7 rounded-full border border-primary bg-bg/70 backdrop-blur text-primary hover:bg-primary hover:text-bg transition-colors text-[11px] shadow-sm"
        data-timeline-restart
        aria-label="Volver al inicio de la era"
      >
        <span aria-hidden="true">⏮</span>
      </button>
      <PlayButton />
      {nextEra ? (
        <a
          href={nextHref}
          class="inline-flex items-center gap-2 text-xs tracking-wider uppercase opacity-60 hover:opacity-100 transition-opacity whitespace-nowrap"
          aria-label={`Siguiente era: ${nextEra.data.name}`}
        >
          <span class="hidden lg:inline">{nextEra.data.name}</span>
          <span>→</span>
        </a>
      ) : null}
    </div>
  </div>
</div>

<style>
  .restart-btn { display: none; }
  body.map-fullscreen .restart-btn { display: inline-flex; }

  @media (max-width: 767px) {
    /* La timeline-nav crece para acomodar la fila de label + año. */
    .timeline-nav { padding-top: 0.5rem; padding-bottom: 0.5rem; }
    .timeline-nav > .flex { height: auto; min-height: 3.25rem; }

    /* Botón trigger que envuelve todo el bloque móvil. */
    .tl-mobile-trigger {
      flex: 1;
      min-width: 0;
      display: flex;
      flex-direction: column;
      align-items: stretch;
      gap: 0.25rem;
      padding: 0;
      background: transparent;
      border: none;
      color: inherit;
      cursor: pointer;
      text-align: center;
    }
    .tl-mobile-trigger:focus-visible { outline: 2px solid var(--era-accent); outline-offset: 2px; border-radius: 4px; }

    .tl-mobile-track {
      position: relative;
      display: grid;
      grid-template-columns: repeat(5, 1fr);
      align-items: center;
      height: 22px;
    }
    .tl-mobile-line {
      position: absolute;
      top: 50%;
      height: 1px;
      transform: translateY(-50%);
      background: color-mix(in srgb, var(--era-primary) 25%, transparent);
      pointer-events: none;
    }
    .tl-mobile-slot {
      display: flex;
      align-items: center;
      justify-content: center;
      height: 22px;
      z-index: 1;
    }
    .tl-mobile-dot {
      width: 6px;
      height: 6px;
      border-radius: 999px;
      background: color-mix(in srgb, var(--era-primary) 40%, transparent);
      transition: width 200ms ease, height 200ms ease, box-shadow 200ms ease, background 200ms ease;
    }
    .tl-mobile-slot.is-active .tl-mobile-dot {
      width: 11px;
      height: 11px;
      background: var(--era-accent);
      box-shadow: 0 0 8px var(--era-accent);
    }
    .tl-mobile-cap {
      font-family: 'Cinzel', serif;
      font-size: 9px;
      letter-spacing: 0.18em;
      text-transform: lowercase;
      color: color-mix(in srgb, var(--era-primary) 55%, transparent);
      white-space: nowrap;
    }
    .tl-mobile-label {
      font-family: 'Cinzel', serif;
      font-size: 11px;
      letter-spacing: 0.14em;
      color: var(--era-primary);
      line-height: 1.2;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }
    .tl-mobile-meta {
      font-size: 9px;
      opacity: 0.55;
      letter-spacing: 0.05em;
    }

    /* Hide desktop track + step arrows on mobile. */
    .timeline-desktop-track { display: none; }
    .step-arrow { display: none; }

    /* Con restart-btn visible (map-fullscreen), comprimir el row. */
    body.map-fullscreen .timeline-nav > .flex { gap: 0.5rem; }
  }
  @media (min-width: 768px) {
    .tl-mobile-trigger { display: none; }
  }
</style>

<script>
  import { isPlaying, jumpToEventId, restartPlay } from '../lib/playMode';
  import { scrollToElement } from '../lib/scrollOffset';
  import { computeSlots, computeLinePct } from '../lib/mobileTimelineWindow';

  // Restart pill (only visible in fullscreen via CSS). PlayButton listens
  // to `timeline:play-state-changed` and syncs its own UI, so we only kick
  // off the engine here and pipe progress to the existing counter.
  const restartBtn = document.querySelector<HTMLButtonElement>('[data-timeline-restart]');
  restartBtn?.addEventListener('click', (e) => {
    e.stopPropagation();
    const playBtn = document.querySelector<HTMLElement>('[data-play-mode]');
    const progress = playBtn?.querySelector<HTMLElement>('[data-play-progress]');
    restartPlay((i, total) => { if (progress) progress.textContent = `${i}/${total}`; });
  });

  function updateActive(eventId: string) {
    const marker = document.querySelector<HTMLAnchorElement>(`[data-timeline-marker="${eventId}"]`);
    const active = document.querySelector<HTMLElement>('[data-timeline-active]');
    if (!marker || !active) return;
    active.style.left = marker.style.left;
  }

  const scenes = document.querySelectorAll<HTMLElement>('[data-event-scene]');
  const observer = new IntersectionObserver((entries) => {
    for (const entry of entries) {
      if (entry.isIntersecting) {
        const id = entry.target.getAttribute('data-event-id');
        if (id) updateActive(id);
      }
    }
  }, { rootMargin: '-40% 0px -40% 0px', threshold: 0 });

  scenes.forEach((s) => observer.observe(s));

  // In fullscreen map mode, the .scenes container is `display:none`, so the
  // IntersectionObserver above never fires and the active dot would freeze on
  // whatever scene was last visible. Listen for the sceneController's
  // `timeline:scene-changed` event (dispatched on every map scene activation)
  // and sync the active dot from there too.
  window.addEventListener('timeline:scene-changed', (e) => {
    const id = (e as CustomEvent).detail?.eventId;
    if (id) updateActive(id);
  });

  // Step arrows: jump to prev/next event step from the timeline bar
  function findCurrentSceneIndex(): number {
    const arr = Array.from(scenes);
    if (arr.length === 0) return 0;
    const center = window.scrollY + window.innerHeight / 2;
    let best = 0;
    let bestDist = Infinity;
    arr.forEach((s, i) => {
      const top = s.getBoundingClientRect().top + window.scrollY + s.offsetHeight / 2;
      const d = Math.abs(top - center);
      if (d < bestDist) { bestDist = d; best = i; }
    });
    return best;
  }

  function goStep(dir: 'prev' | 'next') {
    const arr = Array.from(scenes);
    if (arr.length === 0) return;
    const idx = findCurrentSceneIndex();
    const target = dir === 'prev' ? idx - 1 : idx + 1;
    if (target < 0 || target >= arr.length) return;
    const sceneEl = arr[target];
    const id = sceneEl.dataset.eventId;
    if (isPlaying() && id) {
      const playBtn = document.querySelector<HTMLElement>('[data-play-mode]');
      const progress = playBtn?.querySelector<HTMLElement>('[data-play-progress]');
      jumpToEventId(id, (i, total) => { if (progress) progress.textContent = `${i}/${total}`; });
    } else {
      scrollToElement(sceneEl);
    }
  }

  document.querySelectorAll<HTMLButtonElement>('[data-step-arrow]').forEach((btn) => {
    btn.addEventListener('click', () => {
      const dir = btn.getAttribute('data-step-arrow') as 'prev' | 'next';
      goStep(dir);
    });
  });

  // When in play mode, clicking a timeline dot jumps the narration to that event.
  // Otherwise, perform an offset-aware scroll so the year indicator stays visible
  // below the sticky header stack.
  document.querySelectorAll<HTMLAnchorElement>('[data-timeline-marker]').forEach((dot) => {
    dot.addEventListener('click', (ev) => {
      const id = dot.getAttribute('data-timeline-marker');
      if (!id) return;
      if (isPlaying()) {
        ev.preventDefault();
        const playBtn = document.querySelector<HTMLElement>('[data-play-mode]');
        const progress = playBtn?.querySelector<HTMLElement>('[data-play-progress]');
        jumpToEventId(id, (i, total) => {
          if (progress) progress.textContent = `${i}/${total}`;
        });
        return;
      }
      const target = document.getElementById(`event-${id}`);
      if (target) {
        ev.preventDefault();
        scrollToElement(target);
      }
    });
  });

  /* ── Mobile compact header ─────────────────────────────────────────── */

  const tlMobileTrigger = document.querySelector<HTMLButtonElement>('[data-tl-mobile-trigger]');
  const tlMobileTrack = document.querySelector<HTMLElement>('[data-tl-mobile-track]');
  const tlMobileLabel = document.querySelector<HTMLElement>('[data-tl-mobile-label]');
  const tlMobileMeta = document.querySelector<HTMLElement>('[data-tl-mobile-meta]');

  interface SerializedEvent { id: string; biblicalYear: number; title: string; }
  const slotEventsClient: SerializedEvent[] = Array.from(
    document.querySelectorAll<HTMLElement>('[data-event-scene]')
  ).map((el) => ({
    id: el.dataset.eventId || '',
    biblicalYear: Number(el.dataset.eventYear || 0),
    title: el.dataset.eventTitle || '',
  })).filter((e) => e.id);

  function renderMobileSlots(activeIndex: number) {
    if (!tlMobileTrack || activeIndex < 0 || activeIndex >= slotEventsClient.length) return;
    const slots = computeSlots(slotEventsClient, activeIndex);
    const [lineFrom, lineTo] = computeLinePct(slots);

    tlMobileTrack.innerHTML = '';
    const line = document.createElement('div');
    line.className = 'tl-mobile-line';
    line.setAttribute('data-tl-mobile-line', '');
    line.style.left = `${lineFrom}%`;
    line.style.right = `${100 - lineTo}%`;
    tlMobileTrack.appendChild(line);

    slots.forEach((slot, idx) => {
      const cell = document.createElement('div');
      cell.setAttribute('data-tl-mobile-slot', '');
      cell.dataset.slotIndex = String(idx);
      if (slot.kind === 'dot') {
        cell.className = 'tl-mobile-slot' + (slot.active ? ' is-active' : '');
        cell.dataset.slotKind = 'dot';
        cell.dataset.eventId = slot.eventId;
        const dot = document.createElement('span');
        dot.className = 'tl-mobile-dot';
        cell.appendChild(dot);
      } else {
        cell.className = 'tl-mobile-slot tl-mobile-slot--cap';
        cell.dataset.slotKind = 'cap';
        cell.dataset.capSide = slot.side;
        const cap = document.createElement('span');
        cap.className = 'tl-mobile-cap';
        cap.textContent = slot.side === 'start' ? '‹ inicio' : 'fin ›';
        cell.appendChild(cap);
      }
      tlMobileTrack.appendChild(cell);
    });

    const active = slotEventsClient[activeIndex];
    if (active && tlMobileLabel) tlMobileLabel.textContent = active.title;
    if (active && tlMobileMeta) tlMobileMeta.textContent = `año ${active.biblicalYear} · ${activeIndex + 1}/${slotEventsClient.length}`;
  }

  window.addEventListener('timeline:scene-changed', (e) => {
    const id = (e as CustomEvent).detail?.eventId;
    if (!id) return;
    const idx = slotEventsClient.findIndex((ev) => ev.id === id);
    if (idx >= 0) renderMobileSlots(idx);
  });

  // Trigger opens the dialog (component listens to this event).
  tlMobileTrigger?.addEventListener('click', () => {
    window.dispatchEvent(new CustomEvent('mobile-timeline:open'));
  });
</script>
