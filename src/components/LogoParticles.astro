---
interface Props {
  src?: string;
  src2?: string;
  /** Sample step — bigger = sparser. */
  step?: number;
  alphaThreshold?: number;
  dotRadius?: number;
  /** Opacity of the connecting threads (lines). */
  lineOpacity?: number;
  /** Opacity of the dots. */
  dotOpacity?: number;
  /** Max distance for two particles to be linked by a thread. */
  linkDistance?: number;
  maxLinksPerParticle?: number;
  /** Anchor [x, y] in canvas-fraction units. */
  anchor1?: [number, number];
  anchor2?: [number, number];
  /** Fraction of the canvas each silhouette occupies. */
  silhouetteScale?: number;
  /** Full storm cycle in seconds. */
  cycleSeconds?: number;
  /** Strength of the sand-storm wind during dispersion. */
  windStrength?: number;
  class?: string;
}

const {
  src = '/images/logo.png',
  src2 = '',
  step = 10,
  alphaThreshold = 70,
  dotRadius = 1.1,
  lineOpacity = 0.25,
  dotOpacity = 0.78,
  linkDistance = 18,
  maxLinksPerParticle = 2,
  anchor1 = [0.25, 0.40],
  anchor2 = [0.75, 0.60],
  silhouetteScale = 0.75,
  cycleSeconds = 24,
  windStrength = 1.5,
  class: className = '',
} = Astro.props;
---
<canvas
  class={`logo-particles block w-full h-full ${className}`}
  data-logo-particles
  data-src={src}
  data-src2={src2}
  data-step={step}
  data-alpha={alphaThreshold}
  data-radius={dotRadius}
  data-line-opacity={lineOpacity}
  data-dot-opacity={dotOpacity}
  data-link-distance={linkDistance}
  data-max-links={maxLinksPerParticle}
  data-anchor1={anchor1.join(',')}
  data-anchor2={anchor2.join(',')}
  data-silhouette-scale={silhouetteScale}
  data-cycle-seconds={cycleSeconds}
  data-wind-strength={windStrength}
  aria-hidden="true"
></canvas>

<script>
  /**
   * Sand-storm silhouette cycle.
   *
   * Each particle has two targets (t1 on silhouette 1, t2 on silhouette 2).
   * A single timeline drives the whole cycle:
   *
   *   0%   silhouette 1 assembled
   *   15%  start dispersing
   *   30%  full storm (mix = 1)
   *   45%  storm peak — switch active target to silhouette 2
   *   55%  silhouette 2 assembled (mix = 0 again, with t2 active)
   *   70%  start dispersing
   *   85%  full storm — switch active back to silhouette 1
   *   95%  silhouette 1 assembled
   *   100% loop
   *
   * During the storm phase, particles drift on a turbulent wind field —
   * sin/cos noise + a slow directional drift, with damping so they
   * decelerate before spring-snapping to the next target.
   *
   * Only same-target particles are linked, and only very close ones.
   * The mesh is sparse, almost calligraphic.
   */
  type P = {
    x: number; y: number;
    vx: number; vy: number;
    // two anchored targets
    t1x: number; t1y: number;
    t2x: number; t2y: number;
    ph: number;
    gx: number; gy: number;
  };

  function initOne(canvas: HTMLCanvasElement) {
    const ctx = canvas.getContext('2d', { alpha: true });
    if (!ctx) return;

    const src = canvas.dataset.src!;
    const src2 = canvas.dataset.src2 || '';
    const step = parseInt(canvas.dataset.step ?? '10', 10);
    const alphaTh = parseInt(canvas.dataset.alpha ?? '70', 10);
    const dotR = parseFloat(canvas.dataset.radius ?? '1.1');
    const lineOp = parseFloat(canvas.dataset.lineOpacity ?? '0.25');
    const dotOp = parseFloat(canvas.dataset.dotOpacity ?? '0.78');
    const linkD = parseFloat(canvas.dataset.linkDistance ?? '18');
    const maxLinks = parseInt(canvas.dataset.maxLinks ?? '2', 10);
    const a1 = (canvas.dataset.anchor1 ?? '0.25,0.40').split(',').map(parseFloat) as [number, number];
    const a2 = (canvas.dataset.anchor2 ?? '0.75,0.60').split(',').map(parseFloat) as [number, number];
    const silhScale = parseFloat(canvas.dataset.silhouetteScale ?? '0.75');
    const cycleSec = parseFloat(canvas.dataset.cycleSeconds ?? '24');
    const wind = parseFloat(canvas.dataset.windStrength ?? '1.5');

    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    let W = 0, H = 0;
    let particles: P[] = [];
    let raf = 0;
    let startT = performance.now() / 1000;

    const sources = [src, src2].filter(Boolean) as string[];
    const imgs: HTMLImageElement[] = sources.map(() => new Image());
    let loaded = 0;
    sources.forEach((s, i) => {
      const im = imgs[i];
      im.crossOrigin = 'anonymous';
      const done = () => { loaded++; if (loaded === sources.length) { fit(); buildParticles(); startT = performance.now() / 1000; tick(); } };
      im.addEventListener('load', done);
      im.addEventListener('error', done);
      im.src = s;
    });

    function readColor(name: string, fallback: string): string {
      const v = getComputedStyle(document.body).getPropertyValue(name).trim();
      return v || fallback;
    }

    function fit() {
      const rect = canvas.getBoundingClientRect();
      W = rect.width;
      H = rect.height;
      canvas.width = Math.floor(W * dpr);
      canvas.height = Math.floor(H * dpr);
      ctx!.setTransform(dpr, 0, 0, dpr, 0, 0);
    }

    function sampleImage(img: HTMLImageElement, anchor: [number, number]): { tx: number; ty: number }[] {
      if (!img || !img.complete || !img.naturalWidth) return [];
      const sc = document.createElement('canvas');
      sc.width = img.naturalWidth;
      sc.height = img.naturalHeight;
      const sctx = sc.getContext('2d');
      if (!sctx) return [];
      sctx.drawImage(img, 0, 0);
      let data: ImageData;
      try { data = sctx.getImageData(0, 0, sc.width, sc.height); }
      catch { return []; }
      // Generous silhouette — fills most of the hero vertically.
      const targetW = W * silhScale;
      const targetH = H * silhScale * 1.4;
      const scale = Math.min(targetW / sc.width, targetH / sc.height);
      const offX = W * anchor[0] - (sc.width * scale) / 2;
      const offY = H * anchor[1] - (sc.height * scale) / 2;
      const pts: { tx: number; ty: number }[] = [];
      for (let y = 0; y < sc.height; y += step) {
        for (let x = 0; x < sc.width; x += step) {
          const idx = (y * sc.width + x) * 4;
          if (data.data[idx + 3] < alphaTh) continue;
          // Very small jitter — keeps the silhouette faithful.
          const jx = (Math.random() - 0.5) * step * 0.05;
          const jy = (Math.random() - 0.5) * step * 0.05;
          pts.push({ tx: offX + x * scale + jx, ty: offY + y * scale + jy });
        }
      }
      return pts;
    }

    function buildParticles() {
      const pts1 = imgs[0] ? sampleImage(imgs[0], a1) : [];
      const pts2 = imgs[1] ? sampleImage(imgs[1], a2) : [];
      // Pool size = max of the two so neither silhouette gets thinned out;
      // shorter one recycles points so every particle has both t1 and t2.
      const n = Math.max(pts1.length, pts2.length);
      if (n === 0) { particles = []; return; }
      const all: P[] = [];
      for (let i = 0; i < n; i++) {
        const p1 = pts1.length ? pts1[i % pts1.length] : { tx: W * a1[0], ty: H * a1[1] };
        const p2 = pts2.length ? pts2[i % pts2.length] : { tx: W * a2[0], ty: H * a2[1] };
        all.push({
          x: p1.tx, y: p1.ty,
          vx: 0, vy: 0,
          t1x: p1.tx, t1y: p1.ty,
          t2x: p2.tx, t2y: p2.ty,
          ph: Math.random() * Math.PI * 2,
          gx: 0, gy: 0,
        });
      }
      particles = all;
    }

    const cellSize = linkD;
    let grid: Map<string, P[]> = new Map();
    function rebuildGrid() {
      grid = new Map();
      for (const p of particles) {
        p.gx = Math.floor(p.x / cellSize);
        p.gy = Math.floor(p.y / cellSize);
        const key = `${p.gx},${p.gy}`;
        let arr = grid.get(key);
        if (!arr) { arr = []; grid.set(key, arr); }
        arr.push(p);
      }
    }

    // smoothstep helper
    function ss(edge0: number, edge1: number, x: number): number {
      const t = Math.max(0, Math.min(1, (x - edge0) / (edge1 - edge0)));
      return t * t * (3 - 2 * t);
    }

    /**
     * Cycle layout (single half = 0..0.50; second half mirrors with active=1):
     *   0.00–0.20  hold silhouette  (mix=0, active=current)
     *   0.20–0.32  disperse        (mix 0→1)
     *   0.32–0.36  storm peak; active flips here so when reassembly starts
     *              the particles spring DIRECTLY to the new silhouette
     *              (no "reform to self then jump" artefact).
     *   0.36–0.50  reassemble      (mix 1→0, active = next silhouette)
     *
     * Returns:
     *   active — which silhouette is the spring target (0 or 1)
     *   mix    — 0 fully assembled, 1 fully dispersed
     */
    function phase(tNow: number): { active: 0 | 1; mix: number } {
      const c = ((tNow - startT) % cycleSec) / cycleSec; // 0..1
      const half = c < 0.50 ? 0 : 1;
      const sub = half === 0 ? c : c - 0.50;     // 0..0.50
      // Which silhouette is the "previous" (held at the start of this half)?
      const prevActive = half === 0 ? 0 : 1;
      const nextActive = half === 0 ? 1 : 0;
      let mix: number;
      let active: 0 | 1;
      if (sub < 0.20) {
        // Holding the previous silhouette assembled
        mix = 0;
        active = prevActive as 0 | 1;
      } else if (sub < 0.32) {
        // Dispersing — still targeting the previous silhouette so wind blows
        // particles AWAY from it organically.
        mix = ss(0.20, 0.32, sub);
        active = prevActive as 0 | 1;
      } else if (sub < 0.36) {
        // Storm peak — switch the active target NOW, while mix is at 1
        // (spring is zero anyway, so the swap is invisible). Particles
        // emerging from the storm will home in on the new silhouette.
        mix = 1;
        active = nextActive as 0 | 1;
      } else {
        // Reassembling directly into the new silhouette
        mix = 1 - ss(0.36, 0.50, sub);
        active = nextActive as 0 | 1;
      }
      return { active, mix };
    }

    function tick() {
      const tNow = performance.now() / 1000;
      const t = tNow - startT;
      ctx!.clearRect(0, 0, W, H);

      const primary = readColor('--era-primary', '#d4a574');
      const { active, mix } = phase(tNow);

      // global drift direction — slowly rotates so the storm feels alive
      const driftAng = t * 0.08;
      const driftX = Math.cos(driftAng);
      const driftY = Math.sin(driftAng) * 0.5;

      // Spring strength & damping change with mix
      // mix=0 → strong spring, heavy damping (locked silhouette)
      // mix=1 → no spring, low damping (free drift on wind)
      const spring = 0.055 * (1 - mix);
      const damp = 0.78 + 0.18 * mix; // 0.78 -> 0.96
      const windAmp = wind * mix;

      for (const p of particles) {
        const tx = active === 0 ? p.t1x : p.t2x;
        const ty = active === 0 ? p.t1y : p.t2y;

        // Wind field — turbulent sand-storm. Independent per-axis noise.
        const wx = Math.sin(p.y * 0.012 + t * 0.6 + p.ph) * windAmp
                 + Math.cos(p.x * 0.008 - t * 0.4) * windAmp * 0.6
                 + driftX * windAmp * 0.7;
        const wy = Math.cos(p.x * 0.011 + t * 0.7 + p.ph * 1.3) * windAmp * 0.7
                 + Math.sin(p.y * 0.009 + t * 0.5) * windAmp * 0.5
                 + driftY * windAmp * 0.7;

        // Subtle breathing when assembled
        const breath = (1 - mix) * 0.4;
        const bx = Math.sin(t * 0.7 + p.ph) * breath;
        const by = Math.cos(t * 0.55 + p.ph * 1.2) * breath;

        const ax = (tx - p.x) * spring + wx;
        const ay = (ty - p.y) * spring + wy;

        p.vx = (p.vx + ax) * damp;
        p.vy = (p.vy + ay) * damp;
        p.x += p.vx + bx * (1 - mix);
        p.y += p.vy + by * (1 - mix);
      }

      rebuildGrid();

      // Threads — sparse, only between very close particles. Fade out
      // sharply once the storm starts: lines belong to the assembled state.
      const lineAlphaScale = (1 - mix) * (1 - mix); // (1-mix)^2 — fades fast
      if (lineAlphaScale > 0.02) {
        ctx!.strokeStyle = primary;
        ctx!.lineWidth = 0.55;
        const linkD2 = linkD * linkD;
        for (const p of particles) {
          let links = 0;
          for (let dx = -1; dx <= 1 && links < maxLinks; dx++) {
            for (let dy = -1; dy <= 1 && links < maxLinks; dy++) {
              const key = `${p.gx + dx},${p.gy + dy}`;
              const cell = grid.get(key);
              if (!cell) continue;
              for (const q of cell) {
                if (q === p) continue;
                const ddx = q.x - p.x;
                const ddy = q.y - p.y;
                const d2 = ddx * ddx + ddy * ddy;
                if (d2 > linkD2) continue;
                const a = (1 - d2 / linkD2) * lineOp * lineAlphaScale;
                ctx!.globalAlpha = a;
                ctx!.beginPath();
                ctx!.moveTo(p.x, p.y);
                ctx!.lineTo(q.x, q.y);
                ctx!.stroke();
                links++;
                if (links >= maxLinks) break;
              }
            }
          }
        }
      }

      // Dots — fade slightly during storm so the silhouette read is dominant
      const dotAlpha = dotOp * (0.55 + 0.45 * (1 - mix));
      ctx!.globalAlpha = dotAlpha;
      ctx!.fillStyle = primary;
      for (const p of particles) {
        ctx!.beginPath();
        ctx!.arc(p.x, p.y, dotR, 0, Math.PI * 2);
        ctx!.fill();
      }
      ctx!.globalAlpha = 1;

      raf = requestAnimationFrame(tick);
    }

    let resizeTimer = 0;
    window.addEventListener('resize', () => {
      clearTimeout(resizeTimer);
      resizeTimer = window.setTimeout(() => {
        cancelAnimationFrame(raf);
        fit();
        buildParticles();
        startT = performance.now() / 1000;
        tick();
      }, 120);
    });

    const io = new IntersectionObserver((entries) => {
      for (const e of entries) {
        if (e.isIntersecting) { if (!raf) tick(); }
        else { cancelAnimationFrame(raf); raf = 0; }
      }
    });
    io.observe(canvas);
  }

  function boot() {
    document.querySelectorAll<HTMLCanvasElement>('[data-logo-particles]').forEach(initOne);
  }
  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', boot);
  else boot();
</script>
