---
/**
 * Floating right-side panel that auto-cycles through the active event's
 * characters as the narration progresses. Reuses the look of the hover
 * preview card (mapHoverPreview.ts) — portrait with the same SVG mask,
 * name, role, canonicity badge, body — so the visual identity stays
 * consistent across the app.
 *
 * Visibility:
 *  - Only renders in fullscreen mode (mirror layout of `.fs-narration-panel`).
 *  - Shows when a scene with characters becomes active.
 *  - Pinned visible while narration is running (`body[data-narrating="1"]`,
 *    set by NarratorButton and [id].astro's tick listener).
 *
 * Character cycling — time-slice heuristic:
 *  - On `timeline:scene-changed`: load the event's characters, show the first.
 *  - On `timeline:narration-tick`: pick `characters[floor(progress * N)]`.
 *  - If the event has 0 characters → panel hides.
 *  - If 1 character → no dots, sticks on that character.
 */
import type { CollectionEntry } from 'astro:content';
import { deriveCanonicity } from '../lib/canonicity';

interface Props {
  events: CollectionEntry<'events'>[];
  charById: Map<string, any>;
}
const { events, charById } = Astro.props;

type Tradition = 'tora' | 'biblia' | 'coran';

function hasRealMentions(arr: any[] | undefined): boolean {
  if (!arr || arr.length === 0) return false;
  return arr.some((m) => {
    const marker = m?.book ?? m?.sura ?? m?.reference ?? '';
    return marker !== '—' && marker !== '';
  });
}

function religionsFor(cd: any): Tradition[] {
  const m = cd?.mentions ?? {};
  const out: Tradition[] = [];
  if (hasRealMentions(m.tora))   out.push('tora');
  if (hasRealMentions(m.biblia)) out.push('biblia');
  if (hasRealMentions(m.coran))  out.push('coran');
  return out;
}

const eventCharacters = events.map((e) => {
  const chars = ((e.data.characters as any[]) ?? []).map((c: any) => {
    const cd = charById.get(c.id);
    return {
      id: c.id,
      name: cd?.name ?? c.id,
      portrait: cd?.portrait ?? null,
      role: c.role ?? null,
      lore: c.lore ?? null,
      meaning: cd?.alternateNames?.meaning ?? null,
      significance: cd?.significance ?? null,
      canonicity: deriveCanonicity(cd),
      religions: religionsFor(cd),
    };
  });
  return { eventId: e.data.id, characters: chars };
});
---
<aside class="character-info-panel" data-character-info-panel aria-hidden="true">
  <div class="cip-watermarks" data-cip-watermarks aria-hidden="true">
    <svg class="rel-watermark rel-tora" data-rel="tora" viewBox="0 0 100 100" fill="currentColor"><path d="M50 8 L88 70 L12 70 Z" /><path d="M50 92 L12 30 L88 30 Z" fill-opacity="0.85" /></svg>
    <svg class="rel-watermark rel-biblia" data-rel="biblia" viewBox="0 0 100 100" fill="currentColor"><rect x="42" y="10" width="16" height="80" rx="2" /><rect x="22" y="32" width="56" height="16" rx="2" /></svg>
    <svg class="rel-watermark rel-coran" data-rel="coran" viewBox="0 0 100 100" fill="currentColor"><path d="M50 12 a38 38 0 1 0 32 60 a30 30 0 1 1 0 -44 a38 38 0 0 0 -32 -16 z" /><polygon points="78,28 81,36 89,36 83,41 86,49 78,44 70,49 73,41 67,36 75,36" /></svg>
  </div>
  <div class="cip-row">
    <div class="cip-portrait" data-cip-portrait>
      <img alt="" data-cip-portrait-img onerror="this.style.display='none'" />
    </div>
    <div class="cip-text">
      <div class="cip-meta">
        <span class="cip-kind">Personaje</span>
      </div>
      <div class="cip-name" data-cip-name></div>
      <div class="cip-meaning" data-cip-meaning></div>
    </div>
  </div>
  <div class="cip-role" data-cip-role></div>
  <div class="cip-body" data-cip-body></div>
  <div class="cip-controls" data-cip-controls>
    <button
      type="button"
      class="cip-arrow"
      data-cip-prev
      aria-label="Personaje anterior"
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="15 18 9 12 15 6"></polyline></svg>
    </button>
    <div class="cip-dots" data-cip-dots></div>
    <button
      type="button"
      class="cip-arrow"
      data-cip-next
      aria-label="Personaje siguiente"
    >
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><polyline points="9 18 15 12 9 6"></polyline></svg>
    </button>
  </div>
</aside>

<aside class="mobile-cip" data-mobile-cip aria-hidden="true">
  <div class="cip-watermarks" data-cip-watermarks aria-hidden="true">
    <svg class="rel-watermark rel-tora" data-rel="tora" viewBox="0 0 100 100" fill="currentColor"><path d="M50 8 L88 70 L12 70 Z" /><path d="M50 92 L12 30 L88 30 Z" fill-opacity="0.85" /></svg>
    <svg class="rel-watermark rel-biblia" data-rel="biblia" viewBox="0 0 100 100" fill="currentColor"><rect x="42" y="10" width="16" height="80" rx="2" /><rect x="22" y="32" width="56" height="16" rx="2" /></svg>
    <svg class="rel-watermark rel-coran" data-rel="coran" viewBox="0 0 100 100" fill="currentColor"><path d="M50 12 a38 38 0 1 0 32 60 a30 30 0 1 1 0 -44 a38 38 0 0 0 -32 -16 z" /><polygon points="78,28 81,36 89,36 83,41 86,49 78,44 70,49 73,41 67,36 75,36" /></svg>
  </div>
  <div class="mcip-portrait">
    <img alt="" data-mcip-portrait-img onerror="this.style.display='none'" />
  </div>
  <div class="mcip-text">
    <div class="mcip-name" data-mcip-name></div>
    <div class="mcip-role" data-mcip-role></div>
  </div>
</aside>

<script type="application/json" data-character-info-data set:html={JSON.stringify(eventCharacters)}></script>

<style>
  .character-info-panel {
    display: none;
    position: fixed;
    top: var(--fs-panel-top, 7rem);
    right: var(--fs-col-left, 1.5rem);
    width: clamp(260px, 26vw, 330px);
    max-height: 70vh;
    padding: 1rem 1.15rem 1rem 1.3rem;
    overflow-y: auto;
    z-index: 53;
    /* ── Papyrus background ─────────────────────────────────────────────
       The era's `--era-text` is a warm cream/beige across every theme
       (e.g. patriarcal #e8d4c8, evangelio is similar). We use it as the
       parchment base and blend a faint stripe gradient + an inline
       fractal-noise SVG for the fiber/grain feel. The grain is multiplied
       so the warm base shows through; without `background-blend-mode:
       multiply` the texture sits ON TOP and reads as dirty greys. */
    background-color: color-mix(in srgb, var(--era-text) 96%, var(--era-bg) 4%);
    background-image:
      /* Subtle warm vignette: edges slightly darker so the centre reads
         as a faintly lit scroll. */
      radial-gradient(
        ellipse at center,
        transparent 55%,
        color-mix(in srgb, var(--era-primary) 16%, transparent) 100%
      ),
      /* Paper grain via feTurbulence — fractal noise scaled small and
         tiled. Matrix lifts the noise into a soft dark tone so it reads
         as fibers, not random pixels. */
      url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='220' height='220' viewBox='0 0 220 220'><filter id='n'><feTurbulence type='fractalNoise' baseFrequency='0.82' numOctaves='2' seed='7'/><feColorMatrix values='0 0 0 0 0.16  0 0 0 0 0.10  0 0 0 0 0.06  0 0 0 0.18 0'/></filter><rect width='220' height='220' filter='url(%23n)'/></svg>");
    background-size: cover, 220px 220px;
    background-blend-mode: multiply, multiply;
    border: 1px solid color-mix(in srgb, var(--era-primary) 60%, #3a261a);
    border-radius: 4px;
    /* Layered shadow: inner glow tinted by the era so the scroll feels
       lit from above + outer drop for elevation off the map. */
    box-shadow:
      inset 0 0 18px color-mix(in srgb, var(--era-primary) 14%, transparent),
      inset 0 0 0 1px color-mix(in srgb, var(--era-text) 70%, transparent),
      0 8px 22px rgba(0, 0, 0, 0.45);
    font-family: var(--era-body, 'EB Garamond', Georgia, serif);
    /* Text DARK ink on the light parchment — earlier mix at 55 % primary
       washed out too much on most eras. Going hard charcoal with a tiny
       warm bias so it still feels "ink on aged paper" instead of
       generic black-on-white. Body copy now reads at full strength
       across every theme. */
    color: #1a0f08;
    transition: opacity 360ms ease, transform 360ms ease;
    opacity: 0;
    transform: translateX(10px);
    pointer-events: none;
    scrollbar-width: none;
  }
  .character-info-panel::-webkit-scrollbar { display: none; }

  /* Horizontal row: portrait left, text column right. Body lives BELOW
     the row so it spans the full panel width and has more reading line
     length than if it stayed inside the narrow right column. */
  .character-info-panel .cip-row {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    margin-bottom: 0.4rem;
  }
  .character-info-panel .cip-text {
    flex: 1 1 0;
    min-width: 0;
    padding-top: 0.15rem;
  }

  body.map-fullscreen .character-info-panel.is-active {
    display: block;
    opacity: 0.92;
    transform: translateX(0);
    /* Re-enable pointer events so the prev/next arrows + scroll work
       in fullscreen. The base `pointer-events: none` was meant to let
       clicks fall through to the map underneath, but it also killed
       the panel's own buttons. The transparent gradient edge on the
       left already lets users grab the map there; on the opaque
       parchment area, interactions belong to the panel. */
    pointer-events: auto;
  }
  body.map-fullscreen.map-fullscreen-idle .character-info-panel {
    opacity: 0 !important;
    transform: translateX(10px) !important;
  }
  body.map-fullscreen[data-narrating="1"] .character-info-panel.is-active,
  body.map-fullscreen.map-fullscreen-idle[data-narrating="1"] .character-info-panel.is-active {
    display: block !important;
    opacity: 1 !important;
    transform: translateX(0) !important;
  }

  /* ── NORMAL MODE (non-fullscreen) ────────────────────────────────────
     Anchored to the BOTTOM-RIGHT of the sticky map, sitting just above
     the MapToggleButton ("Mapa antiguo"). The previous top-right
     placement clashed with the next-era arrow, the fullscreen toggle,
     and the play-mode button in the TimelineNav — that whole top band
     is already crowded. Bottom-right is the quiet zone of the map.
     Hidden on mobile (<768px): the map is a 40vh band at the top there
     and a floating panel over the article would obscure reading. */
  @media (min-width: 768px) {
    body:not(.map-fullscreen) .character-info-panel {
      /* Override the default fullscreen anchors so the bottom rule
         below isn't fighting them. */
      top: auto;
      right: 0.75rem;
      bottom: 5rem;
      width: clamp(180px, 17vw, 230px);
      max-height: 60vh;
      padding: 0.75rem 0.95rem 0.75rem 1.1rem;
      /* Normal-mode keeps the same parchment treatment defined on the
         base rule above — we DO NOT re-declare `background` here so the
         multi-layer (color + vignette + grain) survives. Just toughen
         the drop-shadow because the panel sits on a varied map texture
         and needs sharper separation. */
      box-shadow:
        inset 0 0 14px color-mix(in srgb, var(--era-primary) 14%, transparent),
        inset 0 0 0 1px color-mix(in srgb, var(--era-text) 70%, transparent),
        0 6px 18px rgba(0, 0, 0, 0.55);
      pointer-events: auto;
    }
    body:not(.map-fullscreen) .character-info-panel.is-active {
      display: block;
      opacity: 0.97;
      transform: translateX(0);
    }
  }
  /* Inner-element overrides — proportionally shrink so the row still
     fits with the smaller width. Portrait drops 100→76, name 15→13,
     meaning 12→11, body 12→11, gap tightens. */
  @media (min-width: 768px) {
    body:not(.map-fullscreen) .character-info-panel .cip-portrait {
      flex: 0 0 100px;
      width: 100px;
      height: 100px;
    }
    body:not(.map-fullscreen) .character-info-panel .cip-row { gap: 0.55rem; margin-bottom: 0.3rem; }
    body:not(.map-fullscreen) .character-info-panel .cip-name { font-size: 16.5px; }
    body:not(.map-fullscreen) .character-info-panel .cip-meaning { font-size: 14px; }
    body:not(.map-fullscreen) .character-info-panel .cip-body { font-size: 14.5px; line-height: 1.55; }
    body:not(.map-fullscreen) .character-info-panel .cip-role { font-size: 9px; padding: 2px 7px; }
    body:not(.map-fullscreen) .character-info-panel .cip-kind { font-size: 11px; }
  }

  .character-info-panel .cip-portrait {
    /* Bigger portrait — rectangular form with wispy nebula edges
       instead of a circular oval. The mask is a ROUNDED RECTANGLE
       passed through feDisplacementMap + feGaussianBlur so the
       straight edges dissolve into clouds (no visible corners). This
       lets way more of the character's body show — the previous
       ellipse cropped sides aggressively. */
    flex: 0 0 130px;
    width: 130px;
    height: 130px;
    margin: 0;
    -webkit-mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><defs><filter id='c' x='-25' y='-25' width='150' height='150' filterUnits='userSpaceOnUse'><feTurbulence type='fractalNoise' baseFrequency='0.05' numOctaves='3' seed='5' result='n'/><feDisplacementMap in='SourceGraphic' in2='n' scale='16'/><feGaussianBlur stdDeviation='3.2'/></filter><linearGradient id='lg' x1='0' y1='0.5' x2='1' y2='0.5'><stop offset='0' stop-color='black' stop-opacity='0'/><stop offset='0.18' stop-color='black' stop-opacity='0.65'/><stop offset='0.36' stop-color='black' stop-opacity='1'/></linearGradient></defs><rect x='4' y='6' width='92' height='88' rx='10' ry='10' fill='url(%23lg)' filter='url(%23c)'/><rect x='8' y='10' width='86' height='80' rx='6' ry='6' fill='black'/></svg>");
            mask-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><defs><filter id='c' x='-25' y='-25' width='150' height='150' filterUnits='userSpaceOnUse'><feTurbulence type='fractalNoise' baseFrequency='0.05' numOctaves='3' seed='5' result='n'/><feDisplacementMap in='SourceGraphic' in2='n' scale='16'/><feGaussianBlur stdDeviation='3.2'/></filter><linearGradient id='lg' x1='0' y1='0.5' x2='1' y2='0.5'><stop offset='0' stop-color='black' stop-opacity='0'/><stop offset='0.18' stop-color='black' stop-opacity='0.65'/><stop offset='0.36' stop-color='black' stop-opacity='1'/></linearGradient></defs><rect x='4' y='6' width='92' height='88' rx='10' ry='10' fill='url(%23lg)' filter='url(%23c)'/><rect x='8' y='10' width='86' height='80' rx='6' ry='6' fill='black'/></svg>");
    -webkit-mask-size: 100% 100%;
            mask-size: 100% 100%;
    -webkit-mask-repeat: no-repeat;
            mask-repeat: no-repeat;
    filter: drop-shadow(0 0 10px color-mix(in srgb, var(--era-accent) 40%, transparent));
  }
  .character-info-panel .cip-portrait img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top;
    filter: contrast(1.05) saturate(1.05);
    display: block;
  }
  .character-info-panel .cip-meta {
    display: flex; align-items: center; flex-wrap: wrap; gap: 6px;
    margin-bottom: 4px;
  }
  .character-info-panel .cip-kind {
    font-size: 12px; letter-spacing: 0.25em; text-transform: uppercase;
    /* Darken the kicker — 0.55 was unreadable on the warm parchment. */
    opacity: 0.85;
    color: color-mix(in srgb, var(--era-primary) 60%, #1a0f08);
  }
  .character-info-panel .cip-name {
    font-family: var(--era-display, 'Cinzel', serif);
    font-size: 19.5px; letter-spacing: 0.03em;
    /* Always mix with dark ink so the name reads on cream papyrus even
       in eras whose --era-primary is a light tone (primordial, evangelio). */
    color: color-mix(in srgb, var(--era-primary) 55%, #1a0f08);
    line-height: 1.2;
  }
  .character-info-panel .cip-meaning {
    display: none;
    font-style: italic; font-size: 15.5px; opacity: 0.95; margin-top: 2px;
  }
  .character-info-panel .cip-meaning.has-text { display: block; }
  .character-info-panel .cip-role {
    display: none;
    /* Center the pill horizontally — auto margins on a block element
       with width: fit-content collapse the box around its text and
       center the result. */
    margin: 8px auto 0;
    font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
    font-weight: 600;
    padding: 3px 10px;
    text-align: center;
    /* Strong border + darker text so the role pill reads as a stamp,
       not a faint outline. */
    border: 1.5px solid color-mix(in srgb, var(--era-primary) 75%, #1a0f08);
    border-radius: 999px;
    color: color-mix(in srgb, var(--era-primary) 80%, #1a0f08);
    background: color-mix(in srgb, var(--era-text) 50%, transparent);
    width: fit-content;
  }
  .character-info-panel .cip-role.has-text { display: block; }
  /* Body sits below the full portrait+text row so it can use the entire
     panel width — better reading line length for the longer lore/significance
     paragraph than if it were squeezed into the narrow right column. */
  .character-info-panel .cip-body {
    display: none;
    font-size: 15.5px; line-height: 1.55; margin-top: 0.2rem;
    opacity: 1; white-space: pre-line;
  }
  .character-info-panel .cip-body.has-text { display: block; }
  /* Bottom controls row: prev arrow · dots · next arrow. Only rendered
     when the active event has more than one character (the JS hides the
     whole row otherwise via `.has-multi`). Divider tinted to read on
     the parchment — a darkened era-primary rather than the transparent
     line we'd use on a dark background. */
  .character-info-panel .cip-controls {
    display: none;
    align-items: center;
    justify-content: center;
    gap: 0.55rem;
    margin-top: 0.9rem;
    padding-top: 0.55rem;
    border-top: 1px solid color-mix(in srgb, var(--era-primary) 28%, var(--era-text));
  }
  .character-info-panel .cip-controls.has-multi { display: flex; }
  .character-info-panel .cip-arrow {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 24px;
    height: 24px;
    padding: 0;
    /* Solid darker border + ink-coloured stroke so the arrows actually
       read as buttons on the cream parchment. The previous semi-
       transparent treatment dissolved into the paper. */
    border: 1.5px solid color-mix(in srgb, var(--era-primary) 75%, #1a0f08);
    border-radius: 50%;
    background: color-mix(in srgb, var(--era-text) 95%, transparent);
    color: color-mix(in srgb, var(--era-primary) 80%, #1a0f08);
    cursor: pointer;
    transition: background 160ms ease, border-color 160ms ease, transform 100ms ease;
  }
  .character-info-panel .cip-arrow:hover {
    background: color-mix(in srgb, var(--era-accent) 45%, var(--era-text));
    border-color: var(--era-accent);
    color: #1a0f08;
  }
  .character-info-panel .cip-arrow:active { transform: scale(0.92); }
  .character-info-panel .cip-dots {
    display: flex;
    align-items: center;
    gap: 6px;
  }
  .character-info-panel .cip-dot {
    width: 6px; height: 6px; border-radius: 50%;
    background: color-mix(in srgb, var(--era-primary) 25%, transparent);
    transition: background 260ms ease, transform 260ms ease;
  }
  .character-info-panel .cip-dot.is-active {
    background: var(--era-accent);
    transform: scale(1.4);
  }

  /* Cross-fade animation when cycling between characters within the same event. */
  @keyframes cip-fade-in {
    from { opacity: 0; transform: translateY(4px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  .character-info-panel.cip-fade .cip-portrait,
  .character-info-panel.cip-fade .cip-name,
  .character-info-panel.cip-fade .cip-meaning,
  .character-info-panel.cip-fade .cip-role,
  .character-info-panel.cip-fade .cip-body {
    animation: cip-fade-in 320ms ease;
  }

  @media (max-width: 767px) {
    .character-info-panel { display: none !important; }
  }

  .mobile-cip {
    display: none;
    position: fixed;
    bottom: 1rem;
    left: 1rem;
    right: 1rem;
    z-index: 53;
    padding: 0.6rem 0.85rem;
    gap: 0.7rem;
    background: color-mix(in srgb, var(--era-bg) 88%, transparent);
    border: 1px solid var(--era-primary);
    border-radius: 10px;
    backdrop-filter: blur(8px);
    align-items: center;
  }
  .mobile-cip.is-active { display: flex; }
  body.map-fullscreen.map-fullscreen-idle .mobile-cip { opacity: 0; pointer-events: none; }
  @media (min-width: 768px) {
    .mobile-cip { display: none !important; }
  }
  .mcip-portrait { width: 48px; height: 48px; border-radius: 50%; overflow: hidden; flex-shrink: 0; }
  .mcip-portrait img { width: 100%; height: 100%; object-fit: cover; object-position: top center; }
  .mcip-text { min-width: 0; flex: 1 1 auto; }
  .mcip-name {
    font-family: var(--era-display);
    font-size: 1rem;
    line-height: 1.1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mcip-role {
    font-size: 0.65rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    opacity: 0.7;
    margin-top: 0.15rem;
  }

  .cip-watermarks {
    position: absolute;
    inset: 0;
    pointer-events: none;
    z-index: 0;
  }
  .cip-watermarks .rel-watermark {
    position: absolute;
    width: 64px;
    height: 64px;
    opacity: 0;
    color: var(--era-primary);
    pointer-events: none;
    transition: opacity 320ms ease;
  }
  .cip-watermarks .rel-watermark.is-active {
    opacity: 0.10;
  }
  .cip-watermarks .rel-tora { top: 0.6rem; left: 0.6rem; }
  .cip-watermarks .rel-biblia { top: 50%; right: 0.6rem; transform: translateY(-50%); }
  .cip-watermarks .rel-coran { bottom: 0.6rem; left: 0.6rem; }
  /* Mobile flotante watermarks: smaller (panel is narrower) */
  .mobile-cip .cip-watermarks .rel-watermark { width: 28px; height: 28px; opacity: 0; }
  .mobile-cip .cip-watermarks .rel-watermark.is-active { opacity: 0.14; }
  .mobile-cip .cip-watermarks .rel-tora { top: 0.3rem; left: 0.3rem; }
  .mobile-cip .cip-watermarks .rel-biblia { top: 50%; right: 0.3rem; transform: translateY(-50%); }
  .mobile-cip .cip-watermarks .rel-coran { bottom: 0.3rem; left: 0.3rem; }
  /* Ensure panel content sits above watermarks. */
  .character-info-panel .cip-row,
  .character-info-panel .cip-body,
  .character-info-panel .cip-controls,
  .mobile-cip .mcip-portrait,
  .mobile-cip .mcip-text { position: relative; z-index: 1; }
</style>

<script>
  import type { Canonicity } from '../lib/canonicity';

  type Character = {
    id: string;
    name: string;
    portrait: string | null;
    role: string | null;
    lore: string | null;
    meaning: string | null;
    significance: string | null;
    canonicity: Canonicity;
    quote?: string | null;
    religions?: ('tora' | 'biblia' | 'coran')[];
  };

  const dataEl = document.querySelector<HTMLScriptElement>('script[data-character-info-data]');
  const panel = document.querySelector<HTMLElement>('[data-character-info-panel]');
  if (dataEl && panel) {
    let raw: Array<{ eventId: string; characters: Character[] }> = [];
    try { raw = JSON.parse(dataEl.textContent || '[]'); } catch {}
    const byEvent = new Map<string, Character[]>();
    for (const r of raw) byEvent.set(r.eventId, r.characters);

    const portraitImg = panel.querySelector<HTMLImageElement>('[data-cip-portrait-img]');
    const nameEl = panel.querySelector<HTMLElement>('[data-cip-name]');
    const meaningEl = panel.querySelector<HTMLElement>('[data-cip-meaning]');
    const roleEl = panel.querySelector<HTMLElement>('[data-cip-role]');
    const bodyEl = panel.querySelector<HTMLElement>('[data-cip-body]');
    const dotsEl = panel.querySelector<HTMLElement>('[data-cip-dots]');
    const controlsEl = panel.querySelector<HTMLElement>('[data-cip-controls]');
    const prevBtn = panel.querySelector<HTMLButtonElement>('[data-cip-prev]');
    const nextBtn = panel.querySelector<HTMLButtonElement>('[data-cip-next]');

    let activeChars: Character[] = [];
    let activeIdx = -1;
    let activeEventId: string | null = null;

    function emitCharacterActive(c: Character) {
      if (!activeEventId) return;
      try {
        window.dispatchEvent(new CustomEvent('timeline:character-active', {
          detail: {
            eventId: activeEventId,
            charId: c.id,
            quote: (c as any).quote ?? null,
            name: c.name,
          },
        }));
      } catch {}
    }

    // Auto-cycle state. While `narrationActive` is true (a tick has
    // fired in the last 1.5 s) the timer is paused and the tick handler
    // drives `setIdxFromProgress`. Same while the user is hovering the
    // panel (so they can read at their pace). Manual prev/next clicks
    // also reset the timer.
    const AUTO_CYCLE_MS = 6000;
    let autoTimer: ReturnType<typeof setInterval> | null = null;
    let narrationActive = false;
    let narrationFadeTimer: ReturnType<typeof setTimeout> | null = null;
    let hoverPaused = false;

    function startAutoCycle() {
      if (autoTimer != null) return;
      if (activeChars.length <= 1) return;
      if (narrationActive || hoverPaused) return;
      autoTimer = setInterval(() => {
        if (narrationActive || hoverPaused) return;
        if (activeChars.length <= 1) { stopAutoCycle(); return; }
        const next = (activeIdx + 1) % activeChars.length;
        activeIdx = next;
        renderCharacter(activeChars[next]);
        renderControls(activeChars.length, next);
        emitCharacterActive(activeChars[next]);
      }, AUTO_CYCLE_MS);
    }
    function stopAutoCycle() {
      if (autoTimer != null) { clearInterval(autoTimer); autoTimer = null; }
    }
    function restartAutoCycle() {
      stopAutoCycle();
      startAutoCycle();
    }

    function renderControls(n: number, idx: number) {
      // The whole row (arrows + dots) is governed by `has-multi`.
      // Single-character events hide everything — there's nothing to
      // navigate to, the panel just sticks on that one character.
      const multi = n > 1;
      controlsEl?.classList.toggle('has-multi', multi);
      if (!dotsEl) return;
      if (!multi) { dotsEl.innerHTML = ''; return; }
      const parts: string[] = [];
      for (let i = 0; i < n; i++) {
        parts.push(`<span class="cip-dot${i === idx ? ' is-active' : ''}"></span>`);
      }
      dotsEl.innerHTML = parts.join('');
    }

    function setText(el: HTMLElement | null, text: string | null | undefined) {
      if (!el) return;
      const t = (text ?? '').trim();
      el.textContent = t;
      el.classList.toggle('has-text', !!t);
    }

    function renderCharacter(c: Character) {
      if (portraitImg) {
        if (c.portrait) {
          portraitImg.src = c.portrait;
          portraitImg.style.display = '';
        } else {
          portraitImg.removeAttribute('src');
          portraitImg.style.display = 'none';
        }
      }
      setText(nameEl, c.name);
      setText(meaningEl, c.meaning);
      setText(roleEl, c.role);
      // Prefer event-specific lore; fall back to the character's general significance.
      setText(bodyEl, c.lore ?? c.significance);
      // Toggle religion watermarks on both desktop and mobile panels.
      const religions: string[] = Array.isArray((c as any).religions) ? (c as any).religions : [];
      const wmDesktop = document.querySelectorAll<HTMLElement>('.character-info-panel .cip-watermarks .rel-watermark');
      const wmMobile = document.querySelectorAll<HTMLElement>('.mobile-cip .cip-watermarks .rel-watermark');
      [...wmDesktop, ...wmMobile].forEach((el) => {
        const r = el.getAttribute('data-rel');
        el.classList.toggle('is-active', !!r && religions.includes(r));
      });
      // Mirror to the mobile flotante (hidden on desktop via CSS).
      const mobileEl = document.querySelector<HTMLElement>('[data-mobile-cip]');
      const mobileImg = document.querySelector<HTMLImageElement>('[data-mcip-portrait-img]');
      const mobileName = document.querySelector<HTMLElement>('[data-mcip-name]');
      const mobileRole = document.querySelector<HTMLElement>('[data-mcip-role]');
      if (mobileEl) {
        if (c && c.portrait) {
          if (mobileImg) { mobileImg.src = c.portrait; mobileImg.style.display = ''; }
          if (mobileName) mobileName.textContent = c.name;
          if (mobileRole) mobileRole.textContent = (c.role ?? '').replace(/-/g, ' ');
          mobileEl.classList.add('is-active');
        } else {
          mobileEl.classList.remove('is-active');
        }
      }
      // Re-trigger fade animation on the inner blocks. Reflow is needed so the
      // animation actually replays when we re-apply the same class.
      panel!.classList.remove('cip-fade');
      void panel!.offsetWidth;
      panel!.classList.add('cip-fade');
    }

    function showFor(eventId: string) {
      const chars = byEvent.get(eventId) ?? [];
      activeChars = chars;
      activeEventId = eventId;
      stopAutoCycle();
      if (chars.length === 0) {
        panel!.classList.remove('is-active');
        document.querySelector('[data-mobile-cip]')?.classList.remove('is-active');
        activeIdx = -1;
        return;
      }
      activeIdx = 0;
      renderCharacter(chars[0]);
      renderControls(chars.length, 0);
      panel!.classList.add('is-active');
      // Announce the active character so map overlays (speech bubble
      // on the pin) can react. Done AFTER renderCharacter so the panel
      // is in sync with the bubble.
      emitCharacterActive(chars[0]);
      // Kick the auto-cycle for this event. Narration tick will pause
      // it via `narrationActive` if narration is also running.
      startAutoCycle();
    }

    function setIdxFromProgress(progress: number) {
      if (activeChars.length === 0) return;
      const p = Math.max(0, Math.min(1, progress));
      const next = Math.min(activeChars.length - 1, Math.floor(p * activeChars.length));
      if (next === activeIdx) return;
      activeIdx = next;
      renderCharacter(activeChars[next]);
      renderControls(activeChars.length, next);
      emitCharacterActive(activeChars[next]);
    }

    function step(direction: 1 | -1) {
      if (activeChars.length <= 1) return;
      const n = activeChars.length;
      const next = (activeIdx + direction + n) % n;
      activeIdx = next;
      renderCharacter(activeChars[next]);
      renderControls(n, next);
      emitCharacterActive(activeChars[next]);
      // Manual nav → restart the auto-cycle clock so the user doesn't
      // get clobbered by an auto-advance milliseconds after their click.
      restartAutoCycle();
    }

    prevBtn?.addEventListener('click', (e) => { e.stopPropagation(); step(-1); });
    nextBtn?.addEventListener('click', (e) => { e.stopPropagation(); step(1); });

    // Hover-to-pause — desktop only. Touch devices fire `mouseenter`
    // briefly on tap and then `mouseleave`, so this still behaves on
    // mobile (auto-cycle resumes after the tap).
    panel.addEventListener('mouseenter', () => { hoverPaused = true; stopAutoCycle(); });
    panel.addEventListener('mouseleave', () => { hoverPaused = false; startAutoCycle(); });

    window.addEventListener('timeline:scene-changed', (e) => {
      const id = (e as CustomEvent).detail?.eventId;
      if (typeof id === 'string') showFor(id);
    });

    window.addEventListener('timeline:narration-tick', (e) => {
      const { current, duration } = (e as CustomEvent).detail || {};
      if (typeof duration !== 'number' || duration <= 0) return;
      // Narration is driving — hand off cycling to it and pause the auto
      // timer. After 1.5 s of no ticks we consider narration gone and
      // resume auto-cycle.
      narrationActive = true;
      stopAutoCycle();
      if (narrationFadeTimer != null) clearTimeout(narrationFadeTimer);
      narrationFadeTimer = setTimeout(() => {
        narrationActive = false;
        startAutoCycle();
      }, 1500);
      setIdxFromProgress((current ?? 0) / duration);
    });
  }
</script>
