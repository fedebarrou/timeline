---
interface TraditionMention {
  summary: string;
  citation: string;
  fullText: string;
  keyDifferences: string[];
}

interface Props {
  comparative: {
    unified: string;
    divergent: boolean;
    tora?: TraditionMention;
    biblia?: TraditionMention;
    coran?: TraditionMention;
  };
}
const { comparative } = Astro.props;
const rows = [
  { key: 'tora',   label: 'TORÁ',   icon: '📜', data: comparative.tora,   accent: '#d4a574' },
  { key: 'biblia', label: 'BIBLIA', icon: '✝',  data: comparative.biblia, accent: '#e8b87a' },
  { key: 'coran',  label: 'CORÁN',  icon: '☪',  data: comparative.coran,  accent: '#8b9bc4' },
].filter((r) => r.data);
---
<div class="comparative mt-10 border border-border rounded-lg bg-surface/40 overflow-hidden" data-comparative>
  <div class="px-5 py-3 border-b border-border bg-bg/40">
    <p class="text-xs tracking-[0.3em] uppercase opacity-70">Las tradiciones difieren</p>
  </div>

  <div class="tradition-rows divide-y divide-border">
    {rows.map((row, i) => (
      <div
        class="tradition-row grid gap-4 px-5 py-4 items-start hover:bg-bg/20 transition-colors"
        style="grid-template-columns: auto minmax(80px,140px) 1fr"
        data-stagger-index={i}
      >
        <div class="flex items-center gap-2 pt-0.5">
          <span class="inline-block w-2.5 h-2.5 rounded-full flex-shrink-0" style={`background: ${row.accent}`}></span>
          <span class="text-[11px] tracking-[0.25em] opacity-90 whitespace-nowrap">{row.icon} {row.label}</span>
        </div>
        <div class="text-xs opacity-70 leading-relaxed pt-0.5">
          {row.data!.citation}
        </div>
        <div class="text-xs space-y-2">
          <p class="text-sm leading-relaxed">{row.data!.summary}</p>
          {row.data!.fullText && (
            <details>
              <summary class="cursor-pointer hover:opacity-100 select-none opacity-80 text-xs">+ ver cita textual</summary>
              <blockquote class="mt-2 italic border-l-2 border-muted pl-3 text-xs leading-relaxed opacity-80">{row.data!.fullText}</blockquote>
            </details>
          )}
          {row.data!.keyDifferences.length > 0 && (
            <ul class="space-y-1">
              {row.data!.keyDifferences.map((d) => <li class="text-xs opacity-70 leading-snug">• {d}</li>)}
            </ul>
          )}
        </div>
      </div>
    ))}
  </div>
</div>

<style>
  @media (max-width: 768px) {
    .tradition-row {
      grid-template-columns: 1fr !important;
      gap: 0.5rem !important;
    }
  }
</style>
