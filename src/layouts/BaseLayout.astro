---
import SiteNav from '../components/SiteNav.astro';
import EraTheme from '../components/EraTheme.astro';
import FullscreenSandTrail from '../components/FullscreenSandTrail.astro';
import SandPageTransition from '../components/SandPageTransition.astro';
import IntroModal from '../components/IntroModal.astro';
import { getCollection } from 'astro:content';

interface Props {
  title: string;
  description?: string;
  navTitle?: string;
  currentEraId?: string;
  currentEraName?: string;
}
const {
  title,
  description = 'Línea de tiempo bíblica: Adán a Mahoma',
  currentEraId,
  currentEraName,
} = Astro.props;
const bodyEra = currentEraId ?? 'primordial';
const allEras = await getCollection('eras');
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Adán → Mahoma · {title}</title>
    <meta name="description" content={description} />
    <meta name="author" content="Federico Barroumeres" />
    <meta name="copyright" content="© 2026 Federico Barroumeres. All Rights Reserved." />
    <meta name="robots" content="index, follow, noai, noimageai" />
    <link rel="author" href="mailto:fbarroumeres@gmail.com" />
    <link rel="icon" type="image/png" href="/images/logo2.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
    {/* Sand-transition pre-paint flag.
        Runs SYNCHRONOUSLY in <head> before <body> renders. If the
        previous page set the sessionStorage handshake, we add the
        `sand-arriving` class to <html> BEFORE the next paint. CSS in
        SandPageTransition.astro hides every body child except the
        canvas while this class is set — that way the user never sees
        the new page rendered "naked" before the sand FX kicks in.
        The deferred script that runs maybePlayIn() removes the class
        once the settle animation finishes. */}
    <script is:inline>
      (function () {
        try {
          if (sessionStorage.getItem('sand-page-transition') === '1') {
            document.documentElement.classList.add('sand-arriving');
          }
        } catch (e) {}
      })();
    </script>
  </head>
  <body data-era={bodyEra}>
    <script>
      import { applyBootClasses } from '../lib/bootClasses';
      applyBootClasses(navigator, document);
    </script>
    {allEras.map((era) => <EraTheme era={era} />)}
    <SiteNav currentEraId={currentEraId} currentEraName={currentEraName} />
    <FullscreenSandTrail />
    <SandPageTransition />
    <IntroModal />
    <main><slot /></main>
    <style is:global>@import '../styles/global.css';</style>
    <script>
      /* Fixed favicon: composes the logo on a solid black circle so the
         mesh detail of the logo reads clearly regardless of the era's
         background. Runs once on load. */
      (function () {
        const SIZE = 64;
        const PAD = 4;
        const img = new Image();
        img.onload = function () {
          const canvas = document.createElement('canvas');
          canvas.width = SIZE;
          canvas.height = SIZE;
          const ctx = canvas.getContext('2d');
          if (!ctx) return;
          ctx.fillStyle = '#000';
          ctx.beginPath();
          ctx.arc(SIZE / 2, SIZE / 2, SIZE / 2, 0, Math.PI * 2);
          ctx.fill();
          const draw = SIZE - PAD * 2;
          ctx.drawImage(img, PAD, PAD, draw, draw);
          const href = canvas.toDataURL('image/png');
          let link = document.querySelector<HTMLLinkElement>('link[rel="icon"]');
          if (!link) {
            link = document.createElement('link');
            link.rel = 'icon';
            document.head.appendChild(link);
          }
          link.type = 'image/png';
          link.href = href;
        };
        img.src = '/images/logo2.png';
      })();
    </script>
  </body>
</html>
