---
import SiteNav from '../components/SiteNav.astro';

interface Props {
  title: string;
  description?: string;
  navTitle?: string;
  currentEraId?: string;
  currentEraName?: string;
}
const {
  title,
  description = 'Línea de tiempo bíblica: Adán a Mahoma',
  currentEraId,
  currentEraName,
} = Astro.props;
const bodyEra = currentEraId ?? 'primordial';  // server-rendered default
---
<!doctype html>
<html lang="es">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@400;600&family=EB+Garamond:ital,wght@0,400;0,600;1,400&family=Inter:wght@400;500;600&display=swap" rel="stylesheet" />
  </head>
  <body data-era={bodyEra}>
    <SiteNav currentEraId={currentEraId} currentEraName={currentEraName} />
    <main class="pt-16"><slot /></main>
    <style is:global>@import '../styles/global.css';</style>
  </body>
</html>
